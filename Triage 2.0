RAE = f"{YELLOW}{BOLD}"  # Rae's dialogue colour
RAE_END = RESET
NARRATIVE = f"{DIM}"
NARRATIVE_END = RESET
TUTORIAL_PROMPT = f"{CYAN}"
TUTORIAL_PROMPT_END = RESET


def tutorial_rae(text, wait=True):
    """Print a line of Rae's dialogue."""
    print(f"  {RAE}\"{text}\"{RAE_END}")
    if wait:
        input()


def tutorial_rae_raw(text, wait=True):
