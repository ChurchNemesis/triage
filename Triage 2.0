#!/usr/bin/env python3
"""
TRIAGE: The Board Game — Digital Simulation (Single-File Edition)
 
A cooperative board game about running an overnight A&E department.
1-3 players work together to survive a night shift.
 
Usage:
    python triage.py                         Interactive mode
    python triage.py --mode simulate         Run 100 AI-simulated games
    python triage.py --mode simulate -n 500  Simulate 500 games
    python triage.py --seed 42               Reproducible game
    python triage.py --mode simulate -v      Verbose simulation
"""
from __future__ import annotations
 
import argparse
import json
import os
import random
import shutil
import sys
import time
from dataclasses import dataclass, field
from datetime import date
from enum import Enum
from typing import Optional
 
 
# ═══════════════════════════════════════════════════════════════
# CONFIGURATION — All tunable game variables
# ═══════════════════════════════════════════════════════════════
 
DEATH_THRESHOLD = 2
TOTAL_TURNS = 12
NUM_PLAYERS = 3
ACTIONS_PER_PLAYER = 4
ARRIVALS_PER_TURN = 4  # fallback; ARRIVAL_CURVE overrides per-turn
ARRIVAL_CURVE = [4, 4, 4, 4, 3, 3, 3, 3, 2, 2, 2, 2]
TOTAL_PATIENTS = 36
PATIENT_HEALTH = 36
SEVERITY_WEIGHTS = {1: 0.45, 2: 0.40, 3: 0.15}
BRANCHING_FACTOR = 0.72
SYMPTOM_DECK_SIZE = 60
ROOM_CAPACITY = 5
SINGLE_SYMPTOM_RATIO = 0.75
MULTI_SYMPTOM_2_RATIO = 0.80
SHIFT_START_HOUR = 19  # so turn 1 displays as 8:00 PM
STORM_OUT_TURNS = 4    # turns before discharge-ready patients storm out
 
# Harm table: (probability, sev1_harm, sev2_harm, sev3_harm)
# Slight bump to severity 1 and 2 compared to original
SYMPTOM_HARM_TABLE = [
    (0.30, 0, 0, 0),
    (0.20, 0, 0, 1),
    (0.15, 0, 1, 1),
    (0.12, 1, 1, 2),   # sev1: 0->1
    (0.10, 0, 1, 2),   # sev2: 0->1
    (0.05, 1, 1, 2),
    (0.04, 0, 1, 3),
    (0.02, 1, 2, 3),
    (0.01, 0, 2, 3),
    (0.01, 1, 2, 4),
]
 
SYMPTOM_COMPLICATION_TABLE = [
    (0.40, []),
    (0.20, [(0, 1)]),
    (0.10, [(1, 1)]),
    (0.10, [(2, 1)]),
    (0.10, [(0, 2)]),
    (0.04, [(0, 1), (1, 1)]),
    (0.04, [(0, 1), (2, 1)]),
    (0.02, [(0, 3)]),
]
 
 
# ═══════════════════════════════════════════════════════════════
# MODELS
# ═══════════════════════════════════════════════════════════════
 
class SymptomType(Enum):
    BLOOD = "Blood"
    BONE = "Bone"
    BRAIN = "Brain"
 
    def type_by_offset(self, offset: int) -> SymptomType:
        order = [SymptomType.BLOOD, SymptomType.BONE, SymptomType.BRAIN]
        idx = order.index(self)
        return order[(idx + offset) % 3]
 
 
class RoomType(Enum):
    WAITING = "Waiting Room"
    BLOOD = "Blood Room"
    BONE = "Bone Room"
    BRAIN = "Brain Room"
    ADMITTANCE = "Admittance"
 
 
ROOM_TO_SYMPTOM = {
    RoomType.BLOOD: SymptomType.BLOOD,
    RoomType.BONE: SymptomType.BONE,
    RoomType.BRAIN: SymptomType.BRAIN,
}
SYMPTOM_TO_ROOM = {v: k for k, v in ROOM_TO_SYMPTOM.items()}
 
ADJACENT = {
    RoomType.WAITING: {RoomType.BLOOD, RoomType.BONE, RoomType.BRAIN, RoomType.ADMITTANCE},
    RoomType.BLOOD: {RoomType.WAITING},
    RoomType.BONE: {RoomType.WAITING},
    RoomType.BRAIN: {RoomType.WAITING},
    RoomType.ADMITTANCE: {RoomType.WAITING},
}
 
 
@dataclass
class SymptomCard:
    symptom_type: SymptomType
    harm_values: tuple       # (sev1, sev2, sev3)
    complications: list      # [(SymptomType, count), ...]
    face_up: bool = False
 
    def harm_for_severity(self, severity: int) -> int:
        return self.harm_values[severity - 1]
 
    @property
    def complication_text(self) -> str:
        if not self.complications:
            return "No further issues"
        return ", ".join(f"+{c} {t.value}" for t, c in self.complications)
 
 
@dataclass
class Patient:
    id: int
    name: str
    severity: int
    initial_symptoms: list
    symptom_cards: list = field(default_factory=list)
    arrival_turn: Optional[int] = None
    checked_in: bool = False
    current_room: Optional[RoomType] = None
    discharged: bool = False
    admitted: bool = False
    # Tracking fields
    death_turn: Optional[int] = None              # turn when visible harm first reached max
    discharge_turn: Optional[int] = None          # turn when discharged
    admitted_turn: Optional[int] = None            # turn when admitted/transferred
    stormed_out: bool = False                      # auto-discharged after waiting too long
    ready_for_discharge_turn: Optional[int] = None # turn when first tagged discharge-ready
 
    @property
    def harm_rate(self) -> int:
        return sum(c.harm_for_severity(self.severity) for c in self.symptom_cards if c.face_up)
 
    @property
    def total_harm_rate(self) -> int:
        return sum(c.harm_for_severity(self.severity) for c in self.symptom_cards)
 
    def cumulative_harm(self, current_turn: int) -> int:
        if self.arrival_turn is None:
            return 0
        raw = self.harm_rate * (current_turn - self.arrival_turn)
        return min(raw, PATIENT_HEALTH)
 
    def cumulative_harm_total(self, current_turn: int) -> int:
        if self.arrival_turn is None:
            return 0
        raw = self.total_harm_rate * (current_turn - self.arrival_turn)
        return min(raw, PATIENT_HEALTH)
 
    @property
    def is_fully_diagnosed(self) -> bool:
        return all(c.face_up for c in self.symptom_cards)
 
    @property
    def undiagnosed_cards(self) -> list:
        return [c for c in self.symptom_cards if not c.face_up]
 
    @property
    def undiagnosed_types(self) -> set:
        return {c.symptom_type for c in self.symptom_cards if not c.face_up}
 
    @property
    def can_discharge(self) -> bool:
        return self.is_fully_diagnosed and self.harm_rate == 0
 
    @property
    def needs_admittance(self) -> bool:
        return self.is_fully_diagnosed and self.harm_rate > 0
 
 
@dataclass
class Room:
    room_type: RoomType
    queue: list = field(default_factory=list)
    capacity: Optional[int] = None
 
    @property
    def is_full(self) -> bool:
        if self.capacity is None:
            return False
        return len(self.queue) >= self.capacity
 
    @property
    def patient_count(self) -> int:
        return len(self.queue)
 
    def add_patient(self, patient: Patient, position: Optional[int] = None):
        if self.is_full:
            raise ValueError(f"{self.room_type.value} is full ({self.capacity})")
        if position is not None:
            self.queue.insert(position, patient)
        else:
            self.queue.append(patient)
        patient.current_room = self.room_type
 
    def remove_patient(self, patient: Patient):
        self.queue.remove(patient)
 
 
@dataclass
class Player:
    id: int
    current_room: RoomType = RoomType.WAITING
    action_count: int = 0
 
 
