    if wait:
        input()


def barry_says(text, wait=True):
    print(f"  {BOLD}Barry:{RESET} \"{text}\"")
    if wait:
        input()


def steve_says(text, wait=True):
    print(f"  {BOLD}Steve:{RESET} \"{text}\"")
    if wait:
        input()


AUTO_RESOLVE = "AUTO_RESOLVE"


def tutorial_wait_key_escalating(required, responses, final_behavior="repeat"):
    idx = 0
    while True:
        choice = input(f"  > ").strip().lower()
        if choice == required:
            return None
        if idx < len(responses):
            speaker, text = responses[idx]
            if speaker == AUTO_RESOLVE:
                print(f"  {BOLD}{text}{RESET}")
                input()
                return AUTO_RESOLVE
            speaker(text)
            idx += 1
        elif final_behavior == "repeat" and responses:
            speaker, text = responses[-1]
            if speaker == AUTO_RESOLVE:
                return AUTO_RESOLVE
            speaker(text)
        else:
            print(f"  {DIM}In the tutorial, press {BOLD}{required}{RESET}{DIM} to continue.{RESET}")


def tutorial_enter(prompt_text):
    """Wait for Enter with a themed prompt. Returns immediately on Enter."""
    print(f"  {TUTORIAL_PROMPT}({prompt_text}){TUTORIAL_PROMPT_END}")
    input()


def tutorial_wait_key(required, label=None):
    """Wait for a specific key press. Shows gentle prompt on wrong key."""
    if label is None:
        label = required
    while True:
        choice = input(f"  > ").strip().lower()
        if choice == required:
            return
        print(f"  {DIM}In the tutorial, press {BOLD}{label}{RESET}{DIM} to continue.{RESET}")


def tutorial_wait_choice(valid_choices, prompt_text=None):
    """Wait for one of several valid choices. Returns the matched choice."""
    while True:
        if prompt_text:
            choice = input(f"  {prompt_text}: ").strip().lower()
        else:
            choice = input(f"  > ").strip().lower()
        if choice in valid_choices:
            return choice
        keys = "/".join(valid_choices)
        print(f"  {DIM}In the tutorial, press {BOLD}{keys}{RESET}{DIM} to continue.{RESET}")


def tutorial_wait_patient(valid_names, prompt_text, patients_list):
    """Wait for the player to select a specific patient by name or number."""
    # Show the patient list like input_patient does
    print(f"  Available patients:")
    for i, p in enumerate(patients_list):
        st = f"Sev {p.severity}" if p.checked_in else "???"
        rm = p.current_room.value if p.current_room else "?"
        print(f"    {i + 1}. {p.name} ({st}) @ {rm}")
    while True:
        choice = input(f"  {prompt_text}: ").strip()
        # Check by number
        try:
            idx = int(choice) - 1
            if 0 <= idx < len(patients_list) and patients_list[idx].name.lower() in valid_names:
                return patients_list[idx]
        except ValueError:
            pass
        # Check by name
        for p in patients_list:
            if p.name.lower() in valid_names and choice.lower() in p.name.lower():
                return p
        expected = " or ".join(n.title() for n in valid_names)
        print(f"  {DIM}In the tutorial, select {BOLD}{expected}{RESET}{DIM} to continue.{RESET}")


def create_tutorial_game():
    """Create the fixed, pre-determined game state for the tutorial."""
    gs = GameState()
    gs.turn = 6  # Start at hour 6 (2:00 AM with shift_start_hour=20)
    gs.total_turns = 12
    gs.shift_start_hour = 20  # 8 PM start, so turn 6 = 2:00 AM
    gs.rooms = {
        RoomType.WAITING: Room(RoomType.WAITING, capacity=None),
        RoomType.BLOOD: Room(RoomType.BLOOD, capacity=ROOM_CAPACITY),
        RoomType.BONE: Room(RoomType.BONE, capacity=ROOM_CAPACITY),
        RoomType.BRAIN: Room(RoomType.BRAIN, capacity=ROOM_CAPACITY),
        RoomType.ADMITTANCE: Room(RoomType.ADMITTANCE, capacity=ROOM_CAPACITY),
    }
    gs.players = [Player(id=i + 1) for i in range(NUM_PLAYERS)]
    gs.actions_remaining = NUM_PLAYERS * ACTIONS_PER_PLAYER  # 12
    gs.patient_deck = []  # Empty — no arrivals during tutorial
    for st in SymptomType:
        gs.symptom_decks[st] = generate_symptom_deck(st)
        gs.symptom_discards[st] = []
    gs.log = []

    # ── Create patients ──

    # 1. Steve (face-down, unchecked) — will be checked in during step 1
    steve = Patient(id=1, name="Steve", severity=1, initial_symptoms=[SymptomType.BLOOD])
    steve.checked_in = False
    steve.arrival_turn = 6  # T+0 relative to tutorial start
    steve.current_room = RoomType.WAITING

    # 2. Noor — already checked in, fully diagnosed, DISCHARGE READY
    noor = Patient(id=2, name="Noor", severity=1, initial_symptoms=[SymptomType.BONE])
    noor.checked_in = True
    noor.arrival_turn = 6
    noor.current_room = RoomType.WAITING
    # One Bone symptom, already diagnosed with 0 harm
    noor_card = SymptomCard(
        symptom_type=SymptomType.BONE,
        harm_values=(0, 0, 0),
        complications=[],
        face_up=True,
    )
    noor.symptom_cards = [noor_card]
    noor.ready_for_discharge_turn = 6  # Already discharge-ready

    # 3. Barry — already checked in, 2 undiagnosed symptoms
    barry = Patient(id=3, name="Barry", severity=3, initial_symptoms=[SymptomType.BLOOD, SymptomType.BONE])
    barry.checked_in = True
    barry.arrival_turn = 6
    barry.current_room = RoomType.WAITING
    # Blood symptom: when diagnosed, harm +2 at sev3, cascade: +1 Brain
    barry_blood = SymptomCard(
        symptom_type=SymptomType.BLOOD,
        harm_values=(0, 1, 2),
        complications=[(SymptomType.BRAIN, 1)],
        face_up=False,
    )
    # Bone symptom: undiagnosed, we don't diagnose this in the tutorial
    barry_bone = SymptomCard(
        symptom_type=SymptomType.BONE,
        harm_values=(0, 1, 2),
        complications=[],
        face_up=False,
    )
    barry.symptom_cards = [barry_blood, barry_bone]

    # 4. Meg — already checked in, fully diagnosed, needs admittance
    meg = Patient(id=4, name="Meg", severity=2, initial_symptoms=[SymptomType.BRAIN, SymptomType.BLOOD])
    meg.checked_in = True
    meg.arrival_turn = 0  # Arrived at turn 0, so by turn 6 she's been here 6 turns
    meg.current_room = RoomType.WAITING
    # Brain symptom: diagnosed, harm +1 at sev2
    meg_brain = SymptomCard(
        symptom_type=SymptomType.BRAIN,
        harm_values=(0, 1, 1),
        complications=[],
        face_up=True,
    )
    # Blood symptom: diagnosed, harm +1 at sev2
    meg_blood = SymptomCard(
        symptom_type=SymptomType.BLOOD,
        harm_values=(0, 1, 1),
        complications=[],
        face_up=True,
    )
    meg.symptom_cards = [meg_brain, meg_blood]

    # 5. Horris (face-down, unchecked) — auto-checked at end of turn
    horris = Patient(id=5, name="Horris", severity=1, initial_symptoms=[SymptomType.BONE])
    horris.checked_in = False
    horris.arrival_turn = 6
    horris.current_room = RoomType.WAITING

    # Add patients to waiting room in order: Steve(unchecked), Noor, Barry, Meg, Horris(unchecked)
    waiting = gs.get_room(RoomType.WAITING)
    for p in [steve, noor, barry, meg, horris]:
        waiting.queue.append(p)
        p.current_room = RoomType.WAITING
    gs.all_patients = [steve, noor, barry, meg, horris]

    return gs, steve, noor, barry, meg, horris


def run_tutorial():
    """Run the full tutorial mode."""

    # ══════════════════════════════════════════════════════════
    # INTRO — Phase 1: Bus narrative
    # ══════════════════════════════════════════════════════════
    clear_screen()
    print()
    print()

    tutorial_narrative("It's cold. The bus is full.")
    tutorial_narrative("You are about to start your first shift at the hospital.")
    tutorial_narrative("You feel unwell.")
    tutorial_narrative("Is that irony? Or just bad luck.")
    tutorial_narrative("You trained for this.")
    tutorial_narrative("This is what you were born to do, you are going to love this job.")
    print(f"  {YELLOW}You are going to have to love this job.{RESET}")
    input()
    print(f"  {RED}It's what you were born to do.{RESET}")
    input()

    # ── Page break ──
    clear_screen()
    print()

    # ══════════════════════════════════════════════════════════
    # INTRO — Phase 2: Rae's welcome (before game view)
    # ══════════════════════════════════════════════════════════
    tutorial_rae("You've arrived, thank God! What a day I've had! Look at me… I'm going to need at least two showers to get all this off…")
    tutorial_rae("Are you new? I'm Rae, I'm the Senior Nurse Practitioner for about 60 more seconds and then I'm outta here.")
    tutorial_rae("You what?")
    tutorial_rae("Your first shift…ever?")
    tutorial_rae("Oh god! Well, umm…")
    tutorial_rae("I'm supposed to be going to my son's birthday party.")
    tutorial_rae("He's going to be 8 and a half.")
    tutorial_rae("…")
    tutorial_rae("He cries when he's sad, I can't bear it…")
    tutorial_rae_raw("*sigh*")
    tutorial_rae("Ok then. Follow me, let's get you orientated.")

    # ── Create tutorial game state ──
    gs, steve, noor, barry, meg, horris = create_tutorial_game()

    # ── Transition to game view ──
    clear_screen()
    render_full_state(gs)

    tutorial_rae("You're going to be overseeing 3 staff members. I'll just show you how to work with one and then you can figure the rest out.")
    tutorial_rae("You can only designate 12 actions to your staff members per hour. So use them wisely.")
    tutorial_rae("Your shift is 12 hours long. Coffee is your friend.")
    tutorial_rae("Ready?")
    tutorial_enter("Press Enter to nod")

    # Track which player the tutorial uses (can change in Step 4)
    active_idx = 0

    # ══════════════════════════════════════════════════════════
    # STEP 1: Check in — Room action in Waiting Room
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)
    tutorial_rae("Right. You are administrating this hospital ok? You need to make sure everything runs smoothly")
    tutorial_rae("The problem is that they just haven't updated the software in here since Windows 94")
    tutorial_rae("It's really important that you continue to not laugh. The patients much prefer professionalism. Right..")
    tutorial_rae("You can see from the 'Medical staff on shift' board that they are all currently in the Waiting Room")
    tutorial_rae("By default you'll be controlling whoever is top of that list for you at the moment. In this case they have sadly all forgotten to sign in properly so it's Staff Member 1 for the moment")
    tutorial_rae("Just above that is a map of the hospital. It's got a relatively minimalist aesthetic and I actually like it if you must know.")
    tutorial_rae("You can see from your list of patients that two of them are not checked in, hence the [???]. We don't know who they are or what's going on with them.")
    tutorial_rae("Each room has an action that staff can do in it. The room action of the waiting room is 'check patient in' so, while we're here. It might be a good idea to do that? What do you think?")
    tutorial_rae("Press d to use the Waiting Room's room action: check in the front patient.")
    print()

    # Wrong input: same message every time
    while True:
        choice = input(f"  > ").strip().lower()
        if choice == "d":
            break
        tutorial_rae("Oop, that's ok, happens to the best of us. Try again.")

    # Perform check-in on Steve with pre-set symptom card
    steve.checked_in = True
    steve_blood = SymptomCard(
        symptom_type=SymptomType.BLOOD,
        harm_values=(1, 1, 2),
        complications=[],
        face_up=False,
    )
    steve.symptom_cards = [steve_blood]
    gs.actions_remaining -= 1
    gs.players[active_idx].action_count += 1
    gs.log.append(f"Player {gs.players[active_idx].id} checked in Steve (Severity 1, 1 symptom: Blood).")

    render_full_state(gs)
    print(f"  {GREEN}Player {gs.players[active_idx].id} checked in Steve (Severity 1, 1 symptom: Blood).{RESET}")
    print()

    tutorial_rae("Ok Steve-o what's your story? Looks like it's severity 1, so the category of least concern.")
    tutorial_rae("Good.")
    tutorial_rae("He's got a blood symptom that needs looking at.")
    tutorial_rae("We've had to make a lot of changes because of the Ministry for the Administration of Cost-Effectiveness (MACE) recently so he'll have to visit the combined haematology and dermatological breaches room.")
    tutorial_rae("Or, as I like to call it: the Blood Room.")
    tutorial_rae("Please tell me that you are following because otherwise I will scream.")
    tutorial_enter("Press Enter to nod unconvincingly")

    # ══════════════════════════════════════════════════════════
    # STEP 2: Explain the queue and identify priorities
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)
    tutorial_rae("Right. Let's take a look at who's here.")
    tutorial_rae("Steve (Sev 1) — just checked in, needs Blood diagnosis.")
    tutorial_rae("Noor (Sev 1) — already fully diagnosed, with no harm at all. He's marked DISCHARGE READY, so can leave whenever. You'll need to tell him that he's free to go at some point. It's a bad look to have healthy patients just sitting around everywhere.")
    tutorial_rae("Barry (Sev 3) — two undiagnosed symptoms (Blood and Bone). Severity 3 means his symptoms will likely have more underlying harm when diagnosed. He's your die-er, you leave him out too long you're screwed mate.")
    tutorial_rae("Meg (Sev 2) — fully diagnosed but due to the harm we've found in her diagnosis and the time she's been sitting around she's a third of the way to clocking out completely. It's not urgent, urgent, but she needs to be admitted to the hospital. We need to send her to Admittance and the hospital porters will take her at the end of the hour.")
    tutorial_rae("And then we've got our [???] mystery person, who we're going to leave alone for a bit creepy as they are right now. Room actions happen automatically at the end of each hour so we'll know who they are soon enough without having to waste an action. Just try not to look at them, that's what I do. Blaugh, gives me the willies.")
    tutorial_rae("Let's deal with Baz first though. Get him to the Blood Room to figure out what's going on in there.")
    tutorial_enter("Press Enter to write the word \"Barry\" in your notebook")

    # ══════════════════════════════════════════════════════════
    # STEP 3: Send Barry to the Blood Room
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)
    tutorial_rae("To 'send' a patient, press s for 'shout at the top of your lungs'")
    print()

    tutorial_wait_key("s")

    # Patient selection with escalation
    print()
    tutorial_rae("Now decide whose name you're going to shout. I suggest Barry.")
    room_patients = [p for p in gs.get_room(RoomType.WAITING).queue if p.checked_in]
    print(f"  Available patients:")
    for i, p in enumerate(room_patients):
        st = f"Sev {p.severity}" if p.checked_in else "???"
        rm = p.current_room.value if p.current_room else "?"
        print(f"    {i + 1}. {p.name} ({st}) @ {rm}")

    wrong_count = 0
    barry_auto_resolved = False
    while True:
        choice = input(f"  Send which patient: ").strip()
        # Check if Barry was selected
        selected_barry = False
        try:
            idx = int(choice) - 1
            if 0 <= idx < len(room_patients) and room_patients[idx].name.lower() == "barry":
                selected_barry = True
        except ValueError:
            pass
        if not selected_barry:
            for p in room_patients:
                if p.name.lower() == "barry" and choice.lower() in p.name.lower():
                    selected_barry = True
                    break
        if selected_barry:
            break

        wrong_count += 1
        # Resolve wrong name for [NAME] substitution
        wrong_name = choice.upper()
        try:
            idx = int(choice) - 1
            if 0 <= idx < len(room_patients):
                wrong_name = room_patients[idx].name.upper()
        except ValueError:
            for p in room_patients:
                if choice.lower() in p.name.lower():
                    wrong_name = p.name.upper()
                    break

        if wrong_count == 1:
            tutorial_rae(f"SORRY NO, SIT DOWN {wrong_name} PLEASE, I KNOW YOU ARE ALL VERY SICK BUT I'M TRAINING A NEW STAFF MEMBER HERE.")
            tutorial_rae("… would you like to try again?")
        elif wrong_count == 2:
            tutorial_rae("RIGHT, EVERYONE REMAIN SEATED. BARRY YOU'RE ON STANDBY BUT I DO NOT WANT ANY ONE TO MOVE UNTIL OUR NEW ADMINISTRATOR HAS MANAGED TO CALL BARRYS NAME")
            tutorial_rae("… would you like to try again?")
        elif wrong_count == 3:
            tutorial_rae("Nearly there, that was very, very close that time.")
            tutorial_rae("… would you like to try again?")
        elif wrong_count == 4:
            barry_says("Was that Barry? I think I heard Barry?")
        else:
            barry_says("BARRY… Yeah I definitely heard it that time. Coming right now")
            barry_auto_resolved = True
            break

    # Room selection
    print()
    tutorial_rae("Now tell him where to go. I suggest bl for Blood Room.")
    print(f"  Room choices: {DIM}(w)aiting, (bl)ood, (bo)ne, (br)ain, (a)dmittance{RESET}")
    room_wrong = 0
    while True:
        room_choice = input(f"  Send to which room: ").strip().lower()
        if room_choice == "bl":
            break
        room_wrong += 1
        if room_wrong == 1:
            tutorial_rae("BARRY COME BACK! Good Lord! BARRY! Sorry Barry but my colleague here has made an error, the room you actually need to go to is…")
            tutorial_rae("Go on… tell him…")
        else:
            print(f"  {DIM}In the tutorial, press {BOLD}bl{RESET}{DIM} to continue.{RESET}")

    # Execute the send
    waiting = gs.get_room(RoomType.WAITING)
    blood = gs.get_room(RoomType.BLOOD)
    waiting.remove_patient(barry)
    blood.add_patient(barry)
    gs.actions_remaining -= 1
    gs.players[active_idx].action_count += 1
    gs.log.append(f"Player {gs.players[active_idx].id} sent Barry to Blood Room.")

    render_full_state(gs)
    print(f"  {GREEN}Player {gs.players[active_idx].id} sent Barry to Blood Room.{RESET}")
    print()

    tutorial_rae("Ok Barry's in the Blood Room, but there's no-one there to diagnose him. So… say it with me now…")
    tutorial_rae("You're going to have to do it.")
    tutorial_rae("It's just coldbrew coffee in this hipflask ok? Don't want you spreading rumours.")
    tutorial_enter("Press Enter to pretend that you can't smell otherwise")

    # ══════════════════════════════════════════════════════════
    # STEP 4: Move to the Blood Room
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)
    tutorial_rae("OK, lets work those legs. Press m to move.")
    print()

    # Wrong input: two lines, same every time
    while True:
        choice = input(f"  > ").strip().lower()
        if choice == "m":
            break
        tutorial_rae("…Hello?…")
        tutorial_rae("I know its called the waiting room but that titles not really for you…")

    # Player selection — allows picking any player
    print()
    tutorial_rae("The first one. Tell them to go.")
    print(f"  Players: {', '.join(f'P{p.id} @ {p.current_room.value}' for p in gs.players)}")
    valid_players = [str(p.id) for p in gs.players]
    player_choice = tutorial_wait_choice(valid_players, "Which player to move")
    chosen_idx = int(player_choice) - 1
    if chosen_idx != 0:
        tutorial_rae("Oh wow, didn't know I was sharing the space with an anarchist. James Dean's here now is he? Che bloody Guevara's come out to play has he?")
        tutorial_rae("Have it your way")
        active_idx = chosen_idx

    # Room selection
    print()
    tutorial_rae("I shouldn't need to remind you where it is they need to go right?")
    print(f"  Room choices: {DIM}(w)aiting, (bl)ood, (bo)ne, (br)ain, (a)dmittance{RESET}")
    room_wrong = 0
    while True:
        room_choice = input(f"  Move to: ").strip().lower()
        if room_choice == "bl":
            break
        room_wrong += 1
        if room_wrong == 1:
            tutorial_rae("I really shouldn't…")
        else:
            print(f"  {DIM}In the tutorial, press {BOLD}bl{RESET}{DIM} to continue.{RESET}")

    # Execute the move
    gs.players[active_idx].current_room = RoomType.BLOOD
    gs.actions_remaining -= 1
    gs.players[active_idx].action_count += 1
    gs.log.append(f"Player {gs.players[active_idx].id} moved from Waiting Room to Blood Room.")

    render_full_state(gs)
    print(f"  {GREEN}Player {gs.players[active_idx].id} moved from Waiting Room to Blood Room.{RESET}")
    print()

    tutorial_rae("Ok nice. All the right people in all the right places.")
    tutorial_rae("You just need to remind yourself that you're really lucky to have a job like this. It's good to practice gratitude. We'll have Barry sorted out in no time and that's down to hard-working people like us.")
    tutorial_rae("You got the time?")
    tutorial_enter("Press Enter to show Rae your watch")

    # ══════════════════════════════════════════════════════════
    # STEP 5: Diagnose Barry (with pre-set cascade)
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)
    tutorial_rae("D is for diagnose, so press that to figure out what's going on with whoever is front of the queue in the room you're in.")
    tutorial_rae("In this case that's Barry.")
    tutorial_rae("If they've got 2 symptoms of the same type, you can do them both at the same time. That was a MACE idea too, but to be fair we should have thought of that one first.")
    tutorial_rae("Come on Barry, give up your secrets.")
    print()

    tutorial_wait_key("d")

    # Execute pre-set diagnosis: Barry's Blood symptom
    barry_blood = barry.symptom_cards[0]
    barry_blood.face_up = True
    harm = barry_blood.harm_for_severity(barry.severity)

    # Pre-set cascade: add 1x Brain symptom
    barry_brain_cascade = SymptomCard(
        symptom_type=SymptomType.BRAIN,
        harm_values=(0, 1, 2),
        complications=[],
        face_up=False,
    )
    barry.symptom_cards.append(barry_brain_cascade)

    # Return Barry to Waiting Room
    blood.remove_patient(barry)
    waiting.add_patient(barry)
    gs.actions_remaining -= 1
    gs.players[active_idx].action_count += 1
    gs.log.append(f"Player {gs.players[active_idx].id} diagnosed Barry's Blood symptom: harm +{harm} (sev 3). +1 Brain. Patient returned to Waiting Room.")

    render_full_state(gs)
    print(f"  {GREEN}Player {gs.players[active_idx].id} diagnosed Barry's Blood symptom: harm +{harm} (sev 3). +1 Brain. Patient returned to Waiting Room.{RESET}")
    print()

    tutorial_rae("Pissing hell Barry!!")
    tutorial_rae("OK, so Barry's back in the waiting room after his diagnosis, the bad news is that we've uncovered some underlying harm. So that's two per hour that are just going to keep adding up for every turn he's in here. If that hits 36 he's a goner so keep an eye on his chart.")
    tutorial_rae("The other bad news is that in our diagnosis we've also picked up a complication. There was something neurological that we hadn't picked up yet and we're going to have to deal with in the Brain Room which is what I call our combined Neurology and Psychiatry ward.")
    tutorial_rae("So there's that, plus what might be a fracture that will need diagnosis. Guess what I call the musculoskeletal, orthopaedics and rheumatology room..?")
    tutorial_enter("Press Enter to avoid saying the words 'Bone Room'")

    # ══════════════════════════════════════════════════════════
    # STEP 6: Call Steve to the Blood Room
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)
    tutorial_rae("Right, before we go to the waiting room, lets get Steve-o in here, he needs his bloods checked. Press k on that tannoy over there and tell Steve to get himself in here.")
    print()

    step6_escalation = [
        (tutorial_rae, "Less annoying me, more tannoying Steve."),
        (tutorial_rae, "Less trying my patience, and more trying to get patients in this room."),
        (tutorial_rae, "You heard how bad the last one was, I'm not going again. Just call them in the room. Please, I want to go home."),
    ]
    tutorial_wait_key_escalating("k", step6_escalation, final_behavior="prompt")

    # Patient selection — show patients in other rooms
    others = [p for r in gs.rooms.values()
              if r.room_type != gs.players[active_idx].current_room for p in r.queue
              if p.checked_in]
    pat = tutorial_wait_patient(["steve"], "Call which patient", others)

    # Execute the call
    waiting.remove_patient(steve)
    blood.add_patient(steve)
    gs.actions_remaining -= 1
    gs.players[active_idx].action_count += 1
    gs.log.append(f"Player {gs.players[active_idx].id} called Steve from Waiting Room to Blood Room.")

    render_full_state(gs)
    print(f"  {GREEN}Player {gs.players[active_idx].id} called Steve from Waiting Room to Blood Room.{RESET}")
    print()

    tutorial_rae("Ok, so Steve's in here. Nice, we called him here, and we're going to leave him here so that he is auto-diagnosed at the end of the hour. Good stuff.")
    tutorial_rae("Do you know what, I'm having fun, you're a good laugh. This job's not so b—")

    # ══════════════════════════════════════════════════════════
    # STEP 7: Move back to Waiting Room
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)
    tutorial_rae("That's my wife calling… Can't keep doing these extra hours. Not with a family. Have you got kids?")
    steve_says("Oh? Well.. no… sadly not. Always wanted them but my missus says I'm plumbed up all wrong.")
    tutorial_rae("Oh Steve, I actually meant our new recruit here. Sorry about that… either your partner knows what she's talking about and you need to speak to a doctor, or she doesn't and you need to speak to her. Either way something needs fixing. But if you'll excuse us Steve we need to be off.")
    tutorial_rae("Lets go back to the waiting room. I'll let you figure out how to get back there yourself.")
    tutorial_rae("Bye Steve.")
    print()

    step7_move_escalation = [
        (tutorial_rae, "Well that's embarrassing.. Ok Steve… this time we really are going."),
        (tutorial_rae, "..ah.. Look Steve I really am sorry about this.. But our friend here is really trying their best I assure you.."),
        (tutorial_rae, "Tell you what, I'll meet you there. Bye Steve… good luck with your plumbing"),
    ]
    tutorial_wait_key_escalating("m", step7_move_escalation, final_behavior="prompt")

    # Player selection
    print(f"  Players: {', '.join(f'P{p.id} @ {p.current_room.value}' for p in gs.players)}")
    tutorial_wait_choice([str(gs.players[active_idx].id)], "Which player to move")

    # Room selection with Steve's escalating commentary
    print(f"  Room choices: {DIM}(w)aiting, (bl)ood, (bo)ne, (br)ain, (a)dmittance{RESET}")
    step7_room_escalation = [
        (steve_says, "Oop.. that's a wall…"),
        (steve_says, "Ouch.. nearly there"),
        (steve_says, "Ow.. that was the opposite of a door"),
        (steve_says, "Oh wow.. Were you aiming for the door?"),
        (steve_says, "Yowzah.. A little to the left next time"),
        (steve_says, "Ayyiieee.. A lottle to the right"),
        (steve_says, "Why did you try and go over it…? Through it..through the door.."),
        (steve_says, "THROUGH IT…"),
        (steve_says, "UNDER IS NOT AN OPTION! OH MY GOD!!"),
        (steve_says, "RAE COME BACK! PLEASE I'M SCARED! WHAT IS HAPPENING"),
        (steve_says, "YOU'RE BLEEDING MORE THAN I AM! I'm going to be sick…"),
        (steve_says, "Blaughh… please… SOMEBODY"),
        (steve_says, "Blaughh…"),
        (steve_says, "*whimpers*"),
    ]
    room_esc_idx = 0
    while True:
        room_choice = input(f"  Move to: ").strip().lower()
        if room_choice == "w":
            break
        if room_esc_idx < len(step7_room_escalation):
            speaker, text = step7_room_escalation[room_esc_idx]
            speaker(text)
            room_esc_idx += 1
        else:
            # After exhausting the list, repeat the last entry
            speaker, text = step7_room_escalation[-1]
            speaker(text)

    # Execute the move
    gs.players[active_idx].current_room = RoomType.WAITING
    gs.actions_remaining -= 1
    gs.players[active_idx].action_count += 1
    gs.log.append(f"Player {gs.players[active_idx].id} moved from Blood Room to Waiting Room.")

    render_full_state(gs)
    print(f"  {GREEN}Player {gs.players[active_idx].id} moved from Blood Room to Waiting Room.{RESET}")
    print()
    tutorial_enter("Press Enter to give off an air of confidence as you emerge into the waiting room")

    # ══════════════════════════════════════════════════════════
    # STEP 8: Send Meg to Admittance
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)
    tutorial_rae("Okey dokey…")
    tutorial_rae("Meg is fully diagnosed but, because she's accumulated some harm, she can't be discharged. She'll need to be admitted.")
    tutorial_rae("Send her to Admittance and the porters will come pick her up at the end of the hour. Just, fair warning, the porters are a bit… familiar…ok?")
    tutorial_rae("I think you know how to send a patient somewhere now.")
    print()

    tutorial_wait_key("s")

    # Patient selection
    room_patients = [p for p in gs.get_room(RoomType.WAITING).queue if p.checked_in]
    pat = tutorial_wait_patient(["meg"], "Send which patient", room_patients)

    # Room selection
    print(f"  Room choices: {DIM}(w)aiting, (bl)ood, (bo)ne, (br)ain, (a)dmittance{RESET}")
    tutorial_wait_choice(["a", "ad", "admittance"], "Send to which room")

    # Execute the send
    waiting.remove_patient(meg)
    gs.get_room(RoomType.ADMITTANCE).add_patient(meg)
    gs.actions_remaining -= 1
    gs.players[active_idx].action_count += 1
    gs.log.append(f"Player {gs.players[active_idx].id} sent Meg to Admittance.")

    render_full_state(gs)
    print(f"  {GREEN}Player {gs.players[active_idx].id} sent Meg to Admittance.{RESET}")
    print()

    tutorial_rae("If you have a queue building up in Admittance you can go in there yourself and start admitting people with the room action. But since it's just Meg we'll wait it out til the end of the hour.")
    tutorial_enter("Press Enter to wait it out til the end of the hour")

    # ══════════════════════════════════════════════════════════
    # STEP 9: Discharge Noor
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)
    tutorial_rae("Noor on the other hand needs to just be sent home, don't want him giving us a bad review do we? And plus... He's DISCHARGE READY!")
    tutorial_rae("Sorry, didn't mean to shout, I can feel my phone vibrating and I'm feeling a little stressed about it…")
    tutorial_rae("So it's s again to send, but this time just confirm that you're just discharging him. And maybe tell him to be a bit more careful next time, maybe that it's all going to be ok, and we'll always be here if he needs us…")
    tutorial_rae("or something like that ok?")
    tutorial_rae("To recap — if there's harm, sound the alarm (for them to be admitted into hospital), if no harm is there, show you care (and then discharge them).")
    tutorial_rae("OK?")
    tutorial_rae("On we go!")
    print()

    tutorial_wait_key("s")

    # Patient selection
    room_patients = [p for p in gs.get_room(RoomType.WAITING).queue if p.checked_in]
    pat = tutorial_wait_patient(["noor"], "Send which patient", room_patients)

    # Discharge confirmation
    print(f"  {noor.name} can be discharged (0 harm). Discharge? (y/n): ")
    tutorial_wait_choice(["y"], "Discharge? (y/n)")

    # Execute the discharge
    waiting.remove_patient(noor)
    noor.discharged = True
    noor.discharge_turn = gs.turn
    gs.actions_remaining -= 1
    gs.players[active_idx].action_count += 1
    gs.log.append(f"Player {gs.players[active_idx].id} discharged Noor (0 harm, fully diagnosed).")

    render_full_state(gs)
    print(f"  {GREEN}Player {gs.players[active_idx].id} discharged Noor (0 harm, fully diagnosed).{RESET}")
    print()
    tutorial_enter("Press Enter to comfort Noor through a difficult time")

    # ══════════════════════════════════════════════════════════
    # STEP 10: End turn and show auto-functions
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)
    tutorial_rae("Look, we're doing fine here. You got any cigs? I'm gasping.")
    tutorial_rae("...")
    tutorial_rae("Well you should start.")
    tutorial_rae("I know where Dr Legume keeps his in the break room. I'll be back in a second. If you're up for it press e to meet me out back to take the edge off.")
    print()

    tutorial_wait_key("e")

    # Confirm end turn
    print(f"  End turn and forfeit remaining actions? (y/n): ")
    tutorial_wait_choice(["y"], "End turn? (y/n)")

    # ── Execute end of turn with pre-set auto-function results ──
    gs.actions_remaining = 0
    print()
    print(f"\n  {BOLD}End of turn -- room auto-functions activating...{RESET}")

    # Auto-function 1: Waiting Room checks in Horris
    horris.checked_in = True
    horris_bone = SymptomCard(
        symptom_type=SymptomType.BONE,
        harm_values=(1, 1, 2),
        complications=[],
        face_up=False,
    )
    horris.symptom_cards = [horris_bone]
    auto_msg1 = f"[Auto] Waiting Room checked in Horris (Severity 1, 1 symptom: Bone)."
    gs.log.append(auto_msg1)
    print(f"  {YELLOW}{auto_msg1}{RESET}")

    # Auto-function 2: Blood Room diagnoses Steve's Blood symptom
    steve_blood_card = steve.symptom_cards[0]
    steve_blood_card.face_up = True
    steve_harm = steve_blood_card.harm_for_severity(steve.severity)
    blood.remove_patient(steve)
    waiting.add_patient(steve)
    auto_msg2 = f"[Auto] Blood Room diagnosed Steve's Blood: harm +{steve_harm}. No further issues. Returned to Waiting Room."
    gs.log.append(auto_msg2)
    print(f"  {YELLOW}{auto_msg2}{RESET}")

    # Auto-function 3: Bone Room — empty
    # Auto-function 4: Brain Room — empty

    # Auto-function 5: Admittance transfers Meg
    admittance = gs.get_room(RoomType.ADMITTANCE)
    admittance.remove_patient(meg)
    meg.admitted = True
    meg.admitted_turn = gs.turn
    auto_msg5 = f"[Auto] Admittance transferred Meg out of the game."
    gs.log.append(auto_msg5)
    print(f"  {YELLOW}{auto_msg5}{RESET}")

    # Advance turn
    gs.turn = 7

    print()
    tutorial_enter("Press Enter to continue...")

    # ── Post auto-functions dialogue ──
    render_full_state(gs)
    tutorial_rae("The hospital runs a bit without you ordering everyone about, you know.")
    tutorial_rae("So remember to take it slow and look after your own mental health.")
    tutorial_rae("But also lives are at stake and if you take your eyes off the wrong patient for even a second…")
    tutorial_rae("Dead.")
    tutorial_rae("Do you know what I'm saying?")
    tutorial_rae("Coroner. Body on a slab. Weepy children shouting daddy in a cold room. 'Gone but not forgotten'. All of that.")
    tutorial_rae("So mental health on the one hand, actual real health on the other..")
    tutorial_rae("So.")
    tutorial_enter("Press Enter to gently push away the feeling of dread")

    # ══════════════════════════════════════════════════════════
    # STEP 11: Harm tick explanation
    # ══════════════════════════════════════════════════════════
    render_full_state(gs)

    tutorial_rae("Right, lets check in on what's been going on with Barry.")
    tutorial_rae("Hang on… my phone's buzzing again. I'll just…")
    tutorial_rae("Ok, it's on silent… Right lets check on Baz then.")
    tutorial_rae("Ok his cumulative harm is at 2 out of 36, because he's been here an extra hour. Another hour 4, another hour 6. You leave him here he's dead in…")
    tutorial_rae("…12… 16… 18… 18 hours.")
    tutorial_rae("Oh, you leave him here he's next shift's problem, he's still got a couple of symptoms that could have more harm buried in them and you never know how bad it is until you've unpacked it.")
    tutorial_rae("Shall we unpack them? Eh…?")
    tutorial_rae("Figure out what's going on with him?")
    tutorial_rae("Make sure he'll survive the night?")
    tutorial_rae("What do you think?")
    print()
    print(f"  {BOLD}{CYAN}Press s to send Rae home.{RESET}")
    print()

    tutorial_wait_key("s")

    # ══════════════════════════════════════════════════════════
    # STEP 12: Rae's exit
    # ══════════════════════════════════════════════════════════
    clear_screen()
    print()

    tutorial_rae("No wait, I think I should do another hour you haven't really found your feet and I'm worried about Barry.. I…")
    tutorial_rae("Do you remember the difference between discharge and admittance?")
    tutorial_rae("And… And… How many symptoms of the same type are cleared in one go?")
    tutorial_rae("And you have to move multiple staff around? Did you know that? You press P to change. AND IT DOESN'T COST AN ACTION?")
    tutorial_rae("And… And… The inspector! I didn't tell you about the inspector! I have to tell you about the inspector, it's so important.")

    tutorial_enter("Press Enter to remind Rae that she is missing her child's birthday")

    tutorial_rae("FINE! Ok, look, where's my pen. SHIT! Ok let me just write this down for you.")
    tutorial_rae("...")
