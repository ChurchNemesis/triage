# INTERACTIVE MODE
# ═══════════════════════════════════════════════════════════════
 
ROOM_SHORTCUTS = {
    "w": RoomType.WAITING, "waiting": RoomType.WAITING,
    "bl": RoomType.BLOOD, "blood": RoomType.BLOOD,
    "bo": RoomType.BONE, "bone": RoomType.BONE,
    "br": RoomType.BRAIN, "brain": RoomType.BRAIN,
    "a": RoomType.ADMITTANCE, "admittance": RoomType.ADMITTANCE, "ad": RoomType.ADMITTANCE,
}
 
 
def input_room(prompt):
    print(f"  Room choices: {DIM}(w)aiting, (bl)ood, (bo)ne, (br)ain, (a)dmittance  |  c = cancel{RESET}")
    while True:
        choice = input(f"  {prompt}: ").strip().lower()
        if choice == "c":
            return None
        if choice in ROOM_SHORTCUTS:
            return ROOM_SHORTCUTS[choice]
        print(f"  {RED}Invalid room. Try: w, bl, bo, br, a  |  c = cancel{RESET}")
 
 
def input_patient(prompt, patients):
    if not patients:
        print(f"  {RED}No patients available.{RESET}")
        return None
    print(f"  Available patients:  {DIM}(c = cancel){RESET}")
    for i, p in enumerate(patients):
        st = f"Sev {p.severity}" if p.checked_in else "???"
        rm = p.current_room.value if p.current_room else "?"
        print(f"    {i + 1}. {p.name} ({st}) @ {rm}")
    while True:
        choice = input(f"  {prompt} (number or name, c = cancel): ").strip()
        if choice.lower() == "c":
            return None
        try:
            idx = int(choice) - 1
            if 0 <= idx < len(patients):
                return patients[idx]
        except ValueError:
            pass
        for p in patients:
            if choice.lower() in p.name.lower():
                return p
        print(f"  {RED}Invalid choice. Try again or press c to cancel.{RESET}")
 
 
