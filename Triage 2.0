def compute_statistics(gs, result):
    """Compute detailed end-of-game statistics."""
    stats = {}
 
    # Total patients arrived
    stats['total_arrived'] = len(gs.all_patients)
 
    # Discharged
    discharged = [p for p in gs.all_patients if p.discharged]
    stats['discharged_count'] = len(discharged)
    if discharged:
        waits = [(p.discharge_turn - p.arrival_turn) for p in discharged
                 if p.discharge_turn and p.arrival_turn]
        stats['discharged_avg_wait'] = sum(waits) / len(waits) if waits else 0
    else:
        stats['discharged_avg_wait'] = 0
    stats['stormed_out'] = sum(1 for p in discharged if p.stormed_out)
 
    # Admitted & transferred
    admitted = [p for p in gs.all_patients if p.admitted]
    stats['admitted_count'] = len(admitted)
    if admitted:
        waits = [(p.admitted_turn - p.arrival_turn) for p in admitted
                 if p.admitted_turn and p.arrival_turn]
        stats['admitted_avg_wait'] = sum(waits) / len(waits) if waits else 0
    else:
        stats['admitted_avg_wait'] = 0
 
    # Handed over to next shift (remaining, alive)
    death_set = set(id(p) for p in result['deaths'])
    handed_over = [p for p in gs.all_patients
                   if not p.discharged and not p.admitted and id(p) not in death_set]
    stats['handed_over'] = len(handed_over)
 
    # Deaths: in-game vs audit
    in_game = [p for p in result['deaths'] if p.death_turn is not None]
    audit = [p for p in result['deaths'] if p.death_turn is None]
    stats['total_deaths'] = len(result['deaths'])
    stats['in_game_deaths'] = len(in_game)
    stats['audit_deaths'] = len(audit)
 
    # Longest wait
    longest_patient = None
    longest_wait = 0
    for p in gs.all_patients:
        if p.arrival_turn is None:
            continue
        end = p.discharge_turn or p.admitted_turn or gs.total_turns
        wait = end - p.arrival_turn
        if wait > longest_wait:
            longest_wait = wait
            longest_patient = p
    stats['longest_wait_patient'] = longest_patient
    stats['longest_wait_turns'] = longest_wait
 
    # Closest call (survived but highest harm)
    closest_patient = None
    closest_harm = 0
    for p in gs.all_patients:
        if id(p) in death_set:
            continue
        harm = p.cumulative_harm_total(gs.total_turns)
        if harm > closest_harm and harm < PATIENT_HEALTH:
            closest_harm = harm
            closest_patient = p
    stats['closest_call_patient'] = closest_patient
    stats['closest_call_harm'] = closest_harm
 
    # Sickest patient (most symptom cards total)
    sickest = None
    most_cards = 0
    for p in gs.all_patients:
        total_cards = len(p.symptom_cards)
        if total_cards > most_cards:
            most_cards = total_cards
            sickest = p
    stats['sickest_patient'] = sickest
    stats['sickest_cards'] = most_cards
 
    # Busiest doctor
    busiest = max(gs.players, key=lambda p: p.action_count)
    stats['busiest_player'] = busiest
    stats['busiest_actions'] = busiest.action_count
 
    return stats
 
 
def render_statistics(stats):
    """Display end-of-game statistics block."""
    print(f"  {BOLD}End-of-Shift Statistics{RESET}")
    print(f"  {'-' * 50}")
    print(f"  Total patients arrived:       {stats['total_arrived']}")
 
    d_avg = f" (avg {stats['discharged_avg_wait']:.1f} turns)" if stats['discharged_count'] else ""
    print(f"  Patients discharged:          {stats['discharged_count']}{d_avg}")
    if stats['stormed_out'] > 0:
        print(f"    of which stormed out:       {stats['stormed_out']}")
 
    a_avg = f" (avg {stats['admitted_avg_wait']:.1f} turns)" if stats['admitted_count'] else ""
    print(f"  Patients admitted/transferred: {stats['admitted_count']}{a_avg}")
 
    print(f"  Handed over to next shift:    {stats['handed_over']}")
 
    dc = RED if stats['total_deaths'] > DEATH_THRESHOLD else GREEN
    print(f"  Total deaths:                 {dc}{BOLD}{stats['total_deaths']}{RESET}"
          f"  ({stats['in_game_deaths']} during shift, {stats['audit_deaths']} found in audit)")
    print()
 
    lp = stats['longest_wait_patient']
    if lp:
        print(f"  {BOLD}Longest wait:{RESET}    {lp.name} — {stats['longest_wait_turns']} turns in the system")
 
    cp = stats['closest_call_patient']
    if cp:
        print(f"  {BOLD}Closest call:{RESET}    {cp.name} — "
              f"{stats['closest_call_harm']}/{PATIENT_HEALTH} harm (survived)")
 
    sp = stats['sickest_patient']
    if sp:
        print(f"  {BOLD}Sickest patient:{RESET} {sp.name} — {stats['sickest_cards']} symptom cards")
 
    bp = stats['busiest_player']
    print(f"  {BOLD}Busiest doctor:{RESET}  Player {bp.id} — {stats['busiest_actions']} actions used")
    print()
 
 
def render_family_letter(patient_name):
    """Display the family letter for the lose screen."""
    today = date.today().strftime("%d %B %Y")
    print(f"  {DIM}{'─' * 50}{RESET}")
    print()
    print(f"  {DIM}{today}{RESET}")
    print()
    print(f"  To Whom It May Concern,")
    print()
    print(f"  We are writing on behalf of the family of {BOLD}{patient_name}{RESET},")
    print(f"  who died yesterday whilst under the care of the Triage")
    print(f"  Centre.")
    print()
    print(f"  We believe that the care provided to {BOLD}{patient_name}{RESET} fell")
    print(f"  drastically below an acceptable standard, and that this")
    print(f"  failure directly contributed to their death.")
    print()
    print(f"  We intend to pursue with great vigour and fervency, a")
    print(f"  claim of clinical negligence against the staff who stood")
    print(f"  by and did nothing.")
    print()
    print(f"  We request that all medical records, notes, and")
    print(f"  documentation relating to {BOLD}{patient_name}{RESET}'s care be")
    print(f"  preserved and made available upon request.")
    print()
    print(f"  {BOLD}You better have a very, very good lawyer.{RESET}")
    print()
    print(f"  Faithfully")
    print(f"  {BOLD}Jon{RESET}")
    print()
    print(f"  {DIM}{'─' * 50}{RESET}")
    print()
 
 
def render_audit_sequence(gs):
    """Show dramatic patient-by-patient audit at end of game."""
    # Get remaining patients (not yet discharged/admitted)
    remaining = [p for p in gs.all_patients if not p.discharged and not p.admitted]

    clear_screen()
    header_lines = [
        f"{BOLD}{CYAN}{'=' * 60}{RESET}",
        f"{BOLD}  END-OF-SHIFT AUDIT{RESET}",
        f"{CYAN}{'=' * 60}{RESET}",
    ]
    for line in centre_block(header_lines):
        print(line)
    print()
    print(centre_text(f"The next shift has arrived. Time to hand over."))
    print(centre_text(f"{len(remaining)} patient{'s' if len(remaining) != 1 else ''} remain"
          f" in the system and must be fully assessed."))
    print()
    input(centre_text(f"Press Enter to begin the audit..."))
    print()

    for p in remaining:
        # Check in if needed
        if not p.checked_in:
            p.checked_in = True
            assign_symptom_cards(gs, p)

        # Diagnose all remaining cards
        for _ in range(100):
            undiag = [c for c in p.symptom_cards if not c.face_up]
            if not undiag:
                break
            _diagnose_card(gs, p, undiag[0])

        total_harm = p.cumulative_harm_total(gs.total_turns)
        is_dead = total_harm >= PATIENT_HEALTH

        sc = SEV_COLORS.get(p.severity, WHITE)
        if is_dead:
            status = f"{BG_RED}{WHITE}{BOLD} DEAD {RESET}"
        else:
            status = f"{BG_GREEN}{WHITE}{BOLD} SURVIVED {RESET}"

        line = (f"{BOLD}{p.name}{RESET} (Sev {sc}{p.severity}{RESET})"
                f"  Total harm: {total_harm}/{PATIENT_HEALTH}  ...  {status}")
        print(centre_text(line))
        time.sleep(0.6)

    print()
    input(centre_text(f"Press Enter to see the final report..."))
 
 
def render_end_of_game(gs, result):
    stats = compute_statistics(gs, result)
 
    clear_screen()
    print(f"{BOLD}{CYAN}{'=' * 60}{RESET}")
 
    if result["won"]:
        # ── Win Screen ──
        print(f"{BOLD}  CONGRATULATIONS — YOU SURVIVED YOUR SHIFT!{RESET}")
        print(f"{CYAN}{'=' * 60}{RESET}")
        print()
        print(f"  {BG_GREEN}{WHITE}{BOLD} VICTORY {RESET}")
        print()
        print(f"  {DIM}Clearly things aren't too bad in this part of the country.{RESET}")
        print(f"  {DIM}Your funding has been reduced.{RESET}")
        print()
        render_statistics(stats)
        print(f"  {DIM}Press Enter to play again.{RESET}")
        print(f"{CYAN}{'=' * 60}{RESET}")
 
    else:
        # ── Lose Screen ──
        print(f"{BOLD}  GAME OVER{RESET}")
        print(f"{CYAN}{'=' * 60}{RESET}")
        print()
 
        # Family letter — about the last patient who died during the game
        in_game_dead = [p for p in result['deaths'] if p.death_turn is not None]
        if in_game_dead:
            last_dead = max(in_game_dead, key=lambda p: p.death_turn)
            render_family_letter(last_dead.name)
        elif result['deaths']:
            render_family_letter(result['deaths'][-1].name)
 
        render_statistics(stats)
        print(f"  {DIM}Press Enter to play TRIBUNAL: Medical Defence{RESET}")
        print(f"{CYAN}{'=' * 60}{RESET}")
 
    input()
 
 
