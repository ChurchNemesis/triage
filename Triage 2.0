    "Yusuf", "Zara", "Alfie", "Brenda", "Colin", "Doris", "Ernie", "Flora",
    "Gavin", "Horris", "Ivan", "Janet", "Karl", "Linda", "Mick", "Nora",
    "Olaf", "Pat", "Raj", "Sue", "Tom", "Uma", "Vic", "Wendy",
    "Archie", "Bessy", "Clive", "Debra", "Franz", "Grace", "Horris 2", "Iris",
    "Jim", "Kay", "Lennie", "Mabel", "Ned", "Oliver", "Phil", "Rose",
    "Sid", "Trudy", "Ulf", "Val", "Wahid", "Yvonne", "Zack", "Agnes",
    "Barry", "Claude", "Derek", "Elsie", "Femke", "Gwen", "Hugh", "Ivy",
    "Jack", "Kim", "Les", "Moses", "Noor", "Olga", "Pete", "Rowan",
    "Sam", "Pfom", "Uri", "Viv", "Will", "Xander", "Yoko", "Zelda",
]
 
 
def _weighted_choice(table):
    r = random.random()
    cumulative = 0.0
    for row in table:
        cumulative += row[0]
        if r <= cumulative:
            return row
    return table[-1]
 
 
def generate_symptom_deck(symptom_type: SymptomType, size: int = None) -> list:
    if size is None:
        size = SYMPTOM_DECK_SIZE
    deck = []
    for _ in range(size):
        harm_row = _weighted_choice(SYMPTOM_HARM_TABLE)
        harm_values = (harm_row[1], harm_row[2], harm_row[3])
        comp_row = _weighted_choice(SYMPTOM_COMPLICATION_TABLE)
        complications = [(symptom_type.type_by_offset(off), cnt) for off, cnt in comp_row[1]]
        deck.append(SymptomCard(symptom_type, harm_values, complications))
    random.shuffle(deck)
    return deck
 
 
def draw_symptom_card(deck, discard, symptom_type):
    if not deck:
        deck.extend(discard)
        discard.clear()
        random.shuffle(deck)
    if not deck:
        return generate_symptom_deck(symptom_type, 1)[0]
    card = deck.pop(0)
    return SymptomCard(card.symptom_type, card.harm_values, list(card.complications))
 
 
def generate_patient_deck(total=None):
    if total is None:
        total = TOTAL_PATIENTS
    names = list(FIRST_NAMES)
    random.shuffle(names)
    while len(names) < total:
        names.append(f"Patient #{len(names) + 1}")
    patients = []
    severities = [1, 2, 3]
    sev_probs = [SEVERITY_WEIGHTS[s] for s in severities]
    stypes = [SymptomType.BLOOD, SymptomType.BONE, SymptomType.BRAIN]
    for i in range(total):
        sev = random.choices(severities, weights=sev_probs, k=1)[0]
        if random.random() < SINGLE_SYMPTOM_RATIO:
            init_symp = [random.choice(stypes)]
        elif random.random() < MULTI_SYMPTOM_2_RATIO:
            init_symp = random.choices(stypes, k=2)
        else:
            init_symp = random.choices(stypes, k=3)
        patients.append(Patient(id=i + 1, name=names[i], severity=sev, initial_symptoms=init_symp))
    random.shuffle(patients)
    return patients
 
 
# ═══════════════════════════════════════════════════════════════
# GAME ENGINE
# ═══════════════════════════════════════════════════════════════
 
class ActionError(Exception):
    pass
 
 
@dataclass
class GameState:
    turn: int = 0
    total_turns: int = TOTAL_TURNS
    shift_start_hour: int = SHIFT_START_HOUR
    rooms: dict = field(default_factory=dict)
    players: list = field(default_factory=list)
    actions_remaining: int = 0
    patient_deck: list = field(default_factory=list)
    symptom_decks: dict = field(default_factory=dict)
    symptom_discards: dict = field(default_factory=dict)
    all_patients: list = field(default_factory=list)
    log: list = field(default_factory=list)
 
    @property
    def shift_hour(self) -> str:
        h = (self.shift_start_hour + self.turn) % 24
        if h == 0: return "12:00 AM"
        if h < 12: return f"{h}:00 AM"
        if h == 12: return "12:00 PM"
        return f"{h - 12}:00 PM"
 
    def get_room(self, rt: RoomType) -> Room:
        return self.rooms[rt]
 
    def find_patient_room(self, patient: Patient) -> Optional[Room]:
        for room in self.rooms.values():
            if patient in room.queue:
                return room
        return None
 

def create_game(seed=None, late_for_work=False):
    if seed is not None:
        random.seed(seed)
    gs = GameState()
    gs.rooms = {
        RoomType.WAITING: Room(RoomType.WAITING, capacity=None),
        RoomType.BLOOD: Room(RoomType.BLOOD, capacity=ROOM_CAPACITY),
        RoomType.BONE: Room(RoomType.BONE, capacity=ROOM_CAPACITY),
        RoomType.BRAIN: Room(RoomType.BRAIN, capacity=ROOM_CAPACITY),
        RoomType.ADMITTANCE: Room(RoomType.ADMITTANCE, capacity=ROOM_CAPACITY),
    }
    gs.players = [Player(id=i + 1) for i in range(NUM_PLAYERS)]
    gs.patient_deck = generate_patient_deck()
    for st in SymptomType:
        gs.symptom_decks[st] = generate_symptom_deck(st)
        gs.symptom_discards[st] = []
    gs.actions_remaining = NUM_PLAYERS * ACTIONS_PER_PLAYER

    if late_for_work:
        gs.shift_start_hour = 20  # late start: turn 1 displays as 9:00 PM
        gs.total_turns = 11       # fewer turns, still ends at 7:00 AM
        # Simulate turn 1: arrivals only (no harm tick, no auto functions yet)
        gs.turn = 1
        phase_arrivals(gs)
        # Auto-check-in: simulate the waiting room auto-function checking in one patient
        waiting = gs.get_room(RoomType.WAITING)
        if waiting.queue and not waiting.queue[0].checked_in:
            patient = waiting.queue[0]
            patient.checked_in = True
            assign_symptom_cards(gs, patient)
        # Reset turn to 0 so the first begin_turn call increments it to 1
        # (then phase_arrivals for turn 1 fires again, giving 8 total patients)
        gs.turn = 0

    return gs


# ── Save / Load ──

SAVE_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "saves")


def _serialize_symptom_card(card):
    return {
        "symptom_type": card.symptom_type.value,
        "harm_values": list(card.harm_values),
        "complications": [[t.value, c] for t, c in card.complications],
        "face_up": card.face_up,
    }


def _deserialize_symptom_card(d):
    st = SymptomType(d["symptom_type"])
    complications = [(SymptomType(t), c) for t, c in d["complications"]]
    return SymptomCard(
        symptom_type=st,
        harm_values=tuple(d["harm_values"]),
        complications=complications,
        face_up=d["face_up"],
    )


def _serialize_patient(patient):
    return {
        "id": patient.id,
        "name": patient.name,
        "severity": patient.severity,
        "initial_symptoms": [s.value for s in patient.initial_symptoms],
        "symptom_cards": [_serialize_symptom_card(c) for c in patient.symptom_cards],
        "arrival_turn": patient.arrival_turn,
        "checked_in": patient.checked_in,
        "current_room": patient.current_room.value if patient.current_room else None,
        "discharged": patient.discharged,
        "admitted": patient.admitted,
        "death_turn": patient.death_turn,
        "discharge_turn": patient.discharge_turn,
        "admitted_turn": patient.admitted_turn,
        "stormed_out": patient.stormed_out,
        "ready_for_discharge_turn": patient.ready_for_discharge_turn,
    }


def _deserialize_patient(d):
    p = Patient(
        id=d["id"],
        name=d["name"],
        severity=d["severity"],
        initial_symptoms=[SymptomType(s) for s in d["initial_symptoms"]],
    )
    p.symptom_cards = [_deserialize_symptom_card(c) for c in d["symptom_cards"]]
    p.arrival_turn = d["arrival_turn"]
    p.checked_in = d["checked_in"]
    p.current_room = RoomType(d["current_room"]) if d["current_room"] else None
    p.discharged = d["discharged"]
    p.admitted = d["admitted"]
    p.death_turn = d["death_turn"]
    p.discharge_turn = d["discharge_turn"]
    p.admitted_turn = d["admitted_turn"]
    p.stormed_out = d["stormed_out"]
    p.ready_for_discharge_turn = d["ready_for_discharge_turn"]
    return p


def save_game(gs, active_player_id, slot_name=None):
    """Save the current game state to a JSON file. Returns the save file path."""
    os.makedirs(SAVE_DIR, exist_ok=True)
    if slot_name is None:
        # Prompt for a save file name
        slot_name = input(centre_text("Enter a name for this save game: ")).strip()
        if not slot_name:
            slot_name = "save"
    filepath = os.path.join(SAVE_DIR, f"{slot_name}.json")

    # Rooms reference patients already in all_patients by ID
    room_data = {}
    for rt, room in gs.rooms.items():
        room_data[rt.value] = {
            "queue_ids": [p.id for p in room.queue],
            "capacity": room.capacity,
        }

    data = {
        "version": "1.6",
        "turn": gs.turn,
        "total_turns": gs.total_turns,
        "shift_start_hour": gs.shift_start_hour,
        "actions_remaining": gs.actions_remaining,
        "active_player_id": active_player_id,
        "players": [{"id": p.id, "current_room": p.current_room.value,
                      "action_count": p.action_count} for p in gs.players],
        "all_patients": [_serialize_patient(p) for p in gs.all_patients],
        "patient_deck": [_serialize_patient(p) for p in gs.patient_deck],
        "rooms": room_data,
        "symptom_decks": {
            st.value: [_serialize_symptom_card(c) for c in deck]
            for st, deck in gs.symptom_decks.items()
        },
        "symptom_discards": {
            st.value: [_serialize_symptom_card(c) for c in pile]
            for st, pile in gs.symptom_discards.items()
        },
        "log": gs.log,
        "random_state": list(random.getstate()[1]),
        "random_pos": random.getstate()[2],
    }

    with open(filepath, "w") as f:
        json.dump(data, f, indent=2)
    return filepath


def load_game(filepath):
    """Load a game state from a JSON file. Returns (GameState, active_player_id)."""
    with open(filepath, "r") as f:
        data = json.load(f)

    gs = GameState()
    gs.turn = data["turn"]
    gs.total_turns = data["total_turns"]
    gs.shift_start_hour = data.get("shift_start_hour", SHIFT_START_HOUR)
    gs.actions_remaining = data["actions_remaining"]

    # Restore players
    gs.players = []
    for pd in data["players"]:
        p = Player(id=pd["id"], current_room=RoomType(pd["current_room"]),
                   action_count=pd["action_count"])
        gs.players.append(p)

    # Restore all_patients (the canonical patient objects)
    patient_lookup = {}
    gs.all_patients = []
    for pd in data["all_patients"]:
        p = _deserialize_patient(pd)
        gs.all_patients.append(p)
        patient_lookup[p.id] = p

    # Restore patient_deck (these are separate patient objects not yet in play)
    gs.patient_deck = []
    for pd in data["patient_deck"]:
        p = _deserialize_patient(pd)
        gs.patient_deck.append(p)
        patient_lookup[p.id] = p

    # Restore rooms — queue references point to the same patient objects
    gs.rooms = {}
    for rt in RoomType:
        rd = data["rooms"][rt.value]
        room = Room(room_type=rt, capacity=rd["capacity"])
        for pid in rd["queue_ids"]:
            room.queue.append(patient_lookup[pid])
        gs.rooms[rt] = room

    # Restore symptom decks and discards
    gs.symptom_decks = {}
    gs.symptom_discards = {}
    for st in SymptomType:
        gs.symptom_decks[st] = [_deserialize_symptom_card(c)
                                 for c in data["symptom_decks"][st.value]]
        gs.symptom_discards[st] = [_deserialize_symptom_card(c)
                                    for c in data["symptom_discards"][st.value]]

    # Restore log
    gs.log = data["log"]

    # Restore random state
    random_state = (3, tuple(data["random_state"]), data["random_pos"])
    random.setstate(random_state)

    active_player_id = data["active_player_id"]
    return gs, active_player_id


def list_save_files():
    """Return a list of (display_name, filepath) for available save files."""
    if not os.path.isdir(SAVE_DIR):
        return []
    saves = []
    for fname in sorted(os.listdir(SAVE_DIR)):
        if fname.endswith(".json"):
            fpath = os.path.join(SAVE_DIR, fname)
            try:
                with open(fpath, "r") as f:
                    data = json.load(f)
                turn = data.get("turn", "?")
                total = data.get("total_turns", "?")
                slot = fname[:-5]  # strip .json
                saves.append((f"{slot} — Turn {turn}/{total}", fpath))
            except (json.JSONDecodeError, KeyError):
                continue
    return saves


def _draw(gs, symptom_type):
    return draw_symptom_card(gs.symptom_decks[symptom_type],
                             gs.symptom_discards[symptom_type], symptom_type)
 
 
def assign_symptom_cards(gs, patient):
    for stype in patient.initial_symptoms:
        patient.symptom_cards.append(_draw(gs, stype))
 
 
def _diagnose_card(gs, patient, card):
    """Flip a card and handle complications. Returns harm value."""
    card.face_up = True
    harm = card.harm_for_severity(patient.severity)
    for comp_type, comp_count in card.complications:
        for _ in range(comp_count):
            patient.symptom_cards.append(_draw(gs, comp_type))
    return harm
 
 
def check_patient_deaths(gs):
    """Track when patients first die (visible cumulative harm >= health)."""
    for patient in gs.all_patients:
        if patient.discharged or patient.admitted:
            continue
        if patient.death_turn is not None:
            continue
        if patient.checked_in and patient.cumulative_harm(gs.turn) >= PATIENT_HEALTH:
            patient.death_turn = gs.turn
 
 
# ── Player Actions ──
 
def action_move(gs, player, target_room):
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    if target_room not in ADJACENT[player.current_room]:
        raise ActionError(f"Cannot move directly from {player.current_room.value} to "
                          f"{target_room.value}. Must pass through Waiting Room.")
    old = player.current_room
    player.current_room = target_room
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = f"Player {player.id} moved from {old.value} to {target_room.value}."
    gs.log.append(msg)
    return msg
 
 
def action_check_in(gs, player):
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    if player.current_room != RoomType.WAITING:
        raise ActionError("Must be in the Waiting Room to check in patients.")
    waiting = gs.get_room(RoomType.WAITING)
    target = next((p for p in waiting.queue if not p.checked_in), None)
    if target is None:
        raise ActionError("No unchecked patients in the Waiting Room.")
    target.checked_in = True
    assign_symptom_cards(gs, target)
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = (f"Player {player.id} checked in {target.name} (Severity {target.severity}, "
           f"{len(target.symptom_cards)} symptom{'s' if len(target.symptom_cards) != 1 else ''}: "
           f"{', '.join(c.symptom_type.value for c in target.symptom_cards)}).")
    gs.log.append(msg)
    return msg
 
 
def action_diagnose(gs, player):
    """Diagnose up to 2 matching symptom cards on front-of-queue patient."""
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    rt = player.current_room
    if rt not in ROOM_TO_SYMPTOM:
        raise ActionError(f"Cannot diagnose in {rt.value}.")
    stype = ROOM_TO_SYMPTOM[rt]
    room = gs.get_room(rt)
    if not room.queue:
        raise ActionError(f"No patients in {rt.value}.")
    patient = room.queue[0]
    if not patient.checked_in:
        raise ActionError(f"{patient.name} has not been checked in yet.")
    matching = [c for c in patient.symptom_cards if not c.face_up and c.symptom_type == stype]
    if not matching:
        raise ActionError(f"{patient.name} has no undiagnosed {stype.value} symptoms.")
    # Diagnose up to 2 matching cards
    diagnosed = []
    for card in matching[:2]:
        harm = _diagnose_card(gs, patient, card)
        diagnosed.append((card, harm))
    room.remove_patient(patient)
    gs.get_room(RoomType.WAITING).add_patient(patient)
    gs.actions_remaining -= 1
    player.action_count += 1
    if len(diagnosed) == 1:
        card, harm = diagnosed[0]
        msg = (f"Player {player.id} diagnosed {patient.name}'s {stype.value} symptom: "
               f"harm +{harm} (sev {patient.severity}). {card.complication_text}. "
               f"Patient returned to Waiting Room.")
    else:
        total_harm = sum(h for _, h in diagnosed)
        comps = "; ".join(c.complication_text for c, _ in diagnosed)
        msg = (f"Player {player.id} diagnosed 2 of {patient.name}'s {stype.value} symptoms: "
               f"total harm +{total_harm} (sev {patient.severity}). {comps}. "
               f"Patient returned to Waiting Room.")
    gs.log.append(msg)
    return msg
 
 
def action_admit(gs, player):
    """Transfer front patient out of game from Admittance room."""
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    if player.current_room != RoomType.ADMITTANCE:
        raise ActionError("Must be in Admittance to transfer patients.")
    admittance = gs.get_room(RoomType.ADMITTANCE)
    if not admittance.queue:
        raise ActionError("No patients in Admittance.")
    patient = admittance.queue[0]
    admittance.remove_patient(patient)
    patient.admitted = True
    patient.admitted_turn = gs.turn
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = f"Player {player.id} transferred {patient.name} out from Admittance."
    gs.log.append(msg)
    return msg
 
 
def action_send(gs, player, patient, target_room):
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    current = gs.get_room(player.current_room)
    if patient not in current.queue:
        raise ActionError(f"{patient.name} is not in {player.current_room.value}.")
    # Explicit discharge request (target_room is None)
    if target_room is None:
        if not patient.can_discharge:
            raise ActionError(f"{patient.name} cannot be discharged yet.")
        current.remove_patient(patient)
        patient.discharged = True
        patient.discharge_turn = gs.turn
        gs.actions_remaining -= 1
        player.action_count += 1
        msg = f"Player {player.id} discharged {patient.name} (0 harm, fully diagnosed)."
        gs.log.append(msg)
        return msg
    target = gs.get_room(target_room)
    if target.is_full:
        raise ActionError(f"{target_room.value} is full ({target.capacity} patients).")
    current.remove_patient(patient)
    target.add_patient(patient)
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = f"Player {player.id} sent {patient.name} to {target_room.value}."
    gs.log.append(msg)
    return msg
 
 
def action_call(gs, player, patient):
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    player_room = gs.get_room(player.current_room)
    if player_room.is_full:
        raise ActionError(f"{player.current_room.value} is full.")
    source = gs.find_patient_room(patient)
    if source is None:
        raise ActionError(f"{patient.name} is not in any room.")
    if source.room_type == player.current_room:
        raise ActionError(f"{patient.name} is already in {player.current_room.value}.")
    source.remove_patient(patient)
    player_room.add_patient(patient)
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = f"Player {player.id} called {patient.name} from {source.room_type.value} to {player.current_room.value}."
    gs.log.append(msg)
    return msg
 
 
def action_rearrange(gs, player, new_order):
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    room = gs.get_room(player.current_room)
    if sorted(p.id for p in new_order) != sorted(p.id for p in room.queue):
        raise ActionError("New order must contain exactly the same patients.")
    room.queue = list(new_order)
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = f"Player {player.id} rearranged {player.current_room.value} queue: {', '.join(p.name for p in new_order)}."
    gs.log.append(msg)
    return msg
 
 
# ── Turn Phases ──
 
def phase_arrivals(gs):
    if gs.turn >= gs.total_turns:
        return
    count = ARRIVALS_PER_TURN
    if ARRIVAL_CURVE is not None:
        idx = gs.turn - 1
        if 0 <= idx < len(ARRIVAL_CURVE):
            count = ARRIVAL_CURVE[idx]
    waiting = gs.get_room(RoomType.WAITING)
    arrived = []
    for _ in range(count):
        if not gs.patient_deck:
            break
        p = gs.patient_deck.pop(0)
        p.arrival_turn = gs.turn
        waiting.add_patient(p)
        gs.all_patients.append(p)
        arrived.append(p.name)
    if arrived:
        gs.log.append(f"New arrivals: {', '.join(arrived)} ({len(arrived)} patients).")
    else:
        gs.log.append("No new arrivals (patient deck empty).")
 
 
def phase_auto_functions(gs):
    waiting = gs.get_room(RoomType.WAITING)
 
    # Auto check-in
    for patient in waiting.queue:
        if not patient.checked_in:
            patient.checked_in = True
            assign_symptom_cards(gs, patient)
            gs.log.append(f"[Auto] Waiting Room checked in {patient.name} "
                          f"(Severity {patient.severity}, "
                          f"{len(patient.symptom_cards)} symptoms: "
                          f"{', '.join(c.symptom_type.value for c in patient.symptom_cards)}).")
            break
 
    # Auto diagnose (up to 2 matching symptoms per room)
    for rt in [RoomType.BLOOD, RoomType.BONE, RoomType.BRAIN]:
        room = gs.get_room(rt)
        if not room.queue:
            continue
        patient = room.queue[0]
        if not patient.checked_in:
            continue
        stype = ROOM_TO_SYMPTOM[rt]
        matching = [c for c in patient.symptom_cards if not c.face_up and c.symptom_type == stype]
        if not matching:
            continue
        diagnosed = []
        for card in matching[:2]:
            harm = _diagnose_card(gs, patient, card)
            diagnosed.append((card, harm))
        room.remove_patient(patient)
        waiting.add_patient(patient)
        if len(diagnosed) == 1:
            card, harm = diagnosed[0]
            gs.log.append(f"[Auto] {rt.value} diagnosed {patient.name}'s {stype.value}: "
                          f"harm +{harm}. {card.complication_text}. Returned to Waiting Room.")
        else:
            total_harm = sum(h for _, h in diagnosed)
            gs.log.append(f"[Auto] {rt.value} diagnosed {len(diagnosed)} of {patient.name}'s "
                          f"{stype.value} symptoms: total harm +{total_harm}. "
                          f"Returned to Waiting Room.")
 
    # Auto admittance
    admittance = gs.get_room(RoomType.ADMITTANCE)
    if admittance.queue:
        patient = admittance.queue[0]
        admittance.remove_patient(patient)
        patient.admitted = True
        patient.admitted_turn = gs.turn
        gs.log.append(f"[Auto] Admittance transferred {patient.name} out of the game.")
 
    # Tag newly discharge-ready patients
    for room in gs.rooms.values():
        for patient in room.queue:
            if (patient.checked_in and patient.can_discharge
                    and patient.ready_for_discharge_turn is None):
                patient.ready_for_discharge_turn = gs.turn
 
    # Auto storm-out: patients who have waited too long after becoming discharge-ready
    for room in gs.rooms.values():
        for patient in list(room.queue):
            if patient.ready_for_discharge_turn is None:
                continue
            if not patient.can_discharge:
                continue
            turns_waiting = gs.turn - patient.ready_for_discharge_turn
            if turns_waiting >= STORM_OUT_TURNS:
                room.remove_patient(patient)
                patient.discharged = True
                patient.stormed_out = True
                patient.discharge_turn = gs.turn
                gs.log.append(f"[Auto] {patient.name} stormed out! "
                              f"(waited {turns_waiting} turns after being ready for discharge)")
 
 
def begin_turn(gs):
    gs.turn += 1
    gs.actions_remaining = NUM_PLAYERS * ACTIONS_PER_PLAYER
    gs.log.append(f"\n{'=' * 50}")
    gs.log.append(f"TURN {gs.turn} of {gs.total_turns} -- {gs.shift_hour}")
    gs.log.append(f"{'=' * 50}")
    gs.log.append("Harm tick: all patients accumulate damage.")
    # Check for newly dead patients after harm tick
    check_patient_deaths(gs)
    if gs.turn < gs.total_turns:
        phase_arrivals(gs)
    else:
        gs.log.append("Final turn -- no new arrivals.")
 
 
def end_turn(gs):
    phase_auto_functions(gs)
    check_patient_deaths(gs)
 
 
def resolve_end_of_game(gs):
    # Check in all remaining
    for room in gs.rooms.values():
        for patient in room.queue:
            if not patient.checked_in:
                patient.checked_in = True
                assign_symptom_cards(gs, patient)
    # Diagnose all (resolve cascades)
    for _ in range(1000):
        found = False
        for patient in gs.all_patients:
            if patient.discharged or patient.admitted:
                continue
            for card in patient.symptom_cards:
                if not card.face_up:
                    _diagnose_card(gs, patient, card)
                    found = True
                    break
            if found:
                break
        if not found:
            break
    # Count deaths
    deaths, survivors = [], []
    for patient in gs.all_patients:
        if patient.discharged or patient.admitted:
            survivors.append(patient)
            continue
        if patient.cumulative_harm_total(gs.total_turns) >= PATIENT_HEALTH:
            deaths.append(patient)
        else:
            survivors.append(patient)
    return {
        "deaths": deaths,
        "death_count": len(deaths),
        "survivors": survivors,
        "won": len(deaths) <= DEATH_THRESHOLD,
        "total_patients": len(gs.all_patients),
        "discharged": sum(1 for p in gs.all_patients if p.discharged),
        "admitted": sum(1 for p in gs.all_patients if p.admitted),
        "stormed_out": sum(1 for p in gs.all_patients if p.stormed_out),
    }
 
 
def get_patient_status(gs, patient):
    harm = patient.cumulative_harm(gs.turn) if patient.checked_in else 0
    turns = gs.turn - patient.arrival_turn if patient.arrival_turn else 0
    return {
        "name": patient.name,
        "severity": patient.severity if patient.checked_in else "?",
        "checked_in": patient.checked_in,
        "room": patient.current_room.value if patient.current_room else "None",
        "harm_rate": patient.harm_rate if patient.checked_in else "?",
        "cumulative_harm": harm,
        "health": PATIENT_HEALTH,
        "turns_since_arrival": turns,
        "symptoms_total": len(patient.symptom_cards) if patient.checked_in else "?",
        "symptoms_diagnosed": sum(1 for c in patient.symptom_cards if c.face_up) if patient.checked_in else 0,
        "symptoms_remaining": len(patient.undiagnosed_cards) if patient.checked_in else "?",
        "fully_diagnosed": patient.is_fully_diagnosed if patient.checked_in else False,
        "is_dead": harm >= PATIENT_HEALTH if patient.checked_in else False,
    }
 
 
# ═══════════════════════════════════════════════════════════════
# DISPLAY — Terminal UI with ANSI colors
# ═══════════════════════════════════════════════════════════════
 
def _enable_windows_ansi():
    """Enable ANSI escape sequences on Windows 10+."""
    if sys.platform == "win32":
        try:
            import ctypes
            kernel32 = ctypes.windll.kernel32
            kernel32.SetConsoleMode(kernel32.GetStdHandle(-11), 7)
        except Exception:
            pass
 
 
_enable_windows_ansi()
 
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
RED = "\033[91m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
BLUE = "\033[94m"
MAGENTA = "\033[95m"
CYAN = "\033[96m"
WHITE = "\033[97m"
BG_RED = "\033[41m"
BG_GREEN = "\033[42m"
 
SEV_COLORS = {1: GREEN, 2: YELLOW, 3: RED}
SYM_COLORS = {SymptomType.BLOOD: RED, SymptomType.BONE: WHITE, SymptomType.BRAIN: MAGENTA}
ROOM_COLORS = {
    RoomType.WAITING: CYAN,
    RoomType.BLOOD: RED,
    RoomType.BONE: WHITE,
    RoomType.BRAIN: MAGENTA,
    RoomType.ADMITTANCE: GREEN,
}
SYM_ICONS = {SymptomType.BLOOD: "Bl", SymptomType.BONE: "Bo", SymptomType.BRAIN: "Br"}
 
 
def clear_screen():
    if sys.platform == "win32":
        os.system("cls")
    else:
        print("\033[2J\033[H", end="")


def get_terminal_width():
    """Get terminal width, default to 80 if unable to determine."""
    try:
        return shutil.get_terminal_size(fallback=(80, 24)).columns
    except:
        return 80


def centre_text(text):
    """Centre a line of text within the terminal width."""
    width = get_terminal_width()
    # Strip ANSI codes to calculate actual visible width
    visible_text = text
    for code in [RESET, BOLD, DIM, RED, GREEN, YELLOW, BLUE, MAGENTA, CYAN, WHITE, BG_RED, BG_GREEN]:
        visible_text = visible_text.replace(code, "")
    visible_len = len(visible_text)
    padding = max(0, (width - visible_len) // 2)
    return " " * padding + text


def centre_block(lines):
    """Centre a block of text lines. Returns list of centred lines."""
    return [centre_text(line) for line in lines]


def count_current_deaths(gs):
    return sum(1 for p in gs.all_patients
               if not p.discharged and not p.admitted
               and p.checked_in
               and p.cumulative_harm(gs.turn) >= PATIENT_HEALTH)
 
 
def render_header(gs):
    turns_left = gs.total_turns - gs.turn + 1
    progress = gs.turn / gs.total_turns
    bar_w = 30
    filled = int(progress * bar_w)
    bar = "#" * filled + "-" * (bar_w - filled)
 
    print(f"{BOLD}{CYAN}{'=' * 60}{RESET}")
    print(f"{BOLD}  TRIAGE: THE BOARD GAME -- Night Shift{RESET}")
    print(f"{CYAN}{'=' * 60}{RESET}")
    print()
    print(f"  {BOLD}Hour {gs.turn} of {gs.total_turns}{RESET} -- {BOLD}{gs.shift_hour}{RESET}"
          f"    {DIM}({turns_left} turn{'s' if turns_left != 1 else ''} remaining){RESET}")
    print(f"  {DIM}[{bar}]{RESET}")
    print()
 
    actions = gs.actions_remaining
    total_actions = NUM_PLAYERS * ACTIONS_PER_PLAYER
    deaths = count_current_deaths(gs)
    ac = GREEN if actions > total_actions // 2 else (YELLOW if actions > 2 else RED)
    dc = GREEN if deaths == 0 else (YELLOW if deaths <= DEATH_THRESHOLD else RED)
    print(f"  Actions: {ac}{BOLD}{actions}{RESET}/{total_actions}"
          f"    Deaths: {dc}{BOLD}{deaths}{RESET}/{DEATH_THRESHOLD} threshold"
          f"    Deck: {len(gs.patient_deck)} patients remaining")
    print()
 
 
def render_patient_line(gs, patient, prefix, detail=True):
    if not patient.checked_in:
        print(f"{prefix}{DIM}[???] Unknown patient (face-down){RESET}")
        return
    sc = SEV_COLORS[patient.severity]
    hr = patient.harm_rate
    ch = patient.cumulative_harm(gs.turn)
    hp = PATIENT_HEALTH
    turns = gs.turn - patient.arrival_turn if patient.arrival_turn else 0
 
    is_dead = ch >= hp
    dead_str = f" {BG_RED}{WHITE}{BOLD} DEAD {RESET}" if is_dead else ""
 
    # Smell check: dead patient in waiting room for 3+ turns
    smell_str = ""
    if (is_dead and patient.death_turn is not None
            and patient.current_room == RoomType.WAITING
            and gs.turn - patient.death_turn >= 3):
        smell_str = f"\n         {DIM}{patient.name} is starting to smell...{RESET}"
 
    pct = min(ch / hp, 1.0) if hp > 0 else 0
    bw = 10
    bf = int(pct * bw)
    bc = GREEN if pct < 0.5 else (YELLOW if pct < 0.8 else RED)
    hbar = f"{bc}{'|' * bf}{DIM}{'.' * (bw - bf)}{RESET}"
 
    status = ""
    if patient.is_fully_diagnosed:
        if patient.harm_rate == 0:
            if patient.ready_for_discharge_turn is not None:
                turns_left = max(0, STORM_OUT_TURNS - (gs.turn - patient.ready_for_discharge_turn))
                if turns_left > 0:
                    status = f"{GREEN}DISCHARGE READY ({turns_left}){RESET}"
                else:
                    status = f"{YELLOW}ABOUT TO STORM OUT{RESET}"
            else:
                status = f"{GREEN}DISCHARGE READY{RESET}"
        else:
            status = f"{YELLOW}NEEDS ADMITTANCE{RESET}"
 
    print(f"{prefix}{BOLD}{patient.name}{RESET} "
          f"Sev:{sc}{patient.severity}{RESET} HR:{hr} [{hbar}] {ch}/{hp}{dead_str} {status}"
          f"{smell_str}")
 
    if detail:
        cards = []
        for c in patient.symptom_cards:
            col = SYM_COLORS[c.symptom_type]
            icon = SYM_ICONS[c.symptom_type]
            if c.face_up:
                cards.append(f"{col}[{icon}:+{c.harm_for_severity(patient.severity)}]{RESET}")
            else:
                cards.append(f"{col}[{icon}:?]{RESET}")
        if cards:
            dc = sum(1 for c in patient.symptom_cards if c.face_up)
            tc = len(patient.symptom_cards)
            print(f"         Symptoms ({dc}/{tc}): {' '.join(cards)}  {DIM}(T+{turns}){RESET}")
 
 
def render_room(gs, rt, detail=True):
    room = gs.get_room(rt)
    c = ROOM_COLORS[rt]
    cap = f"/{room.capacity}" if room.capacity else ""
    pstrs = [f"P{p.id}" for p in gs.players if p.current_room == rt]
    ph = f" [{', '.join(pstrs)}]" if pstrs else ""
    print(f"  {c}{BOLD}{rt.value}{RESET} ({room.patient_count}{cap}){ph}")
    if not room.queue:
        print(f"    {DIM}(empty){RESET}")
        return
    for i, patient in enumerate(room.queue):
        render_patient_line(gs, patient, f"    {i + 1}. ", detail)
 
 
def render_map(gs):
    print(f"  {BOLD}Hospital Map:{RESET}")
    print()
    def tag(rt):
        r = gs.get_room(rt)
        c = ROOM_COLORS[rt]
        cap = f"/{r.capacity}" if r.capacity else ""
        return f"{c}{rt.value}({r.patient_count}{cap}){RESET}"
    print(f"                    {tag(RoomType.BLOOD)}")
    print(f"                         |")
    print(f"    {tag(RoomType.BONE)} -- {tag(RoomType.WAITING)} -- {tag(RoomType.BRAIN)}")
    print(f"                         |")
    print(f"                    {tag(RoomType.ADMITTANCE)}")
    print()
 
 
def render_players(gs):
    print(f"  {BOLD}Players:{RESET}")
    for p in gs.players:
        c = ROOM_COLORS[p.current_room]
        print(f"    Player {p.id}: {c}{p.current_room.value}{RESET}")
    print()
 
 
def render_full_state(gs):
    clear_screen()
    render_header(gs)
    render_map(gs)
    render_players(gs)
    print(f"  {BOLD}{'-' * 56}{RESET}")
    print()
    for rt in [RoomType.WAITING, RoomType.BLOOD, RoomType.BONE,
               RoomType.BRAIN, RoomType.ADMITTANCE]:
        render_room(gs, rt)
        print()
    print(f"  {BOLD}{'-' * 56}{RESET}")
    print()
 
 
def render_action_menu(gs, pid):
    player = gs.players[pid - 1]
    print(f"  {BOLD}Player {player.id} @ {player.current_room.value}{RESET} "
          f"({gs.actions_remaining} actions left)")
    print()
    print(f"  Actions:")
    print(f"    {BOLD}m{RESET} - Move to adjacent room")
    # Contextual room action
    if player.current_room == RoomType.WAITING:
        print(f"    {BOLD}d{RESET} - Room action: Check in front patient")
    elif player.current_room in ROOM_TO_SYMPTOM:
        print(f"    {BOLD}d{RESET} - Room action: Diagnose front patient (up to 2 symptoms)")
    elif player.current_room == RoomType.ADMITTANCE:
        print(f"    {BOLD}d{RESET} - Room action: Transfer front patient out")
    print(f"    {BOLD}s{RESET} - Send patient to another room / Discharge")
    print(f"    {BOLD}k{RESET} - Call patient to this room")
    print(f"    {BOLD}r{RESET} - Rearrange queue in this room")
    print(f"    {BOLD}p{RESET} - Switch active player")
    print(f"    {BOLD}e{RESET} - End turn (forfeit remaining actions)")
    print(f"    {BOLD}x{RESET} - Examine patient details")
    print(f"    {BOLD}i{RESET} - How to play")
    print(f"    {BOLD}v{RESET} - Save game")
    print(f"    {BOLD}q{RESET} - Quit game")
    print()


def render_difficulty_selection():
    """Show difficulty selection screen after New Game is selected."""
    clear_screen()
    print()
    lines = [
        f"{BOLD}{CYAN}╔═══════════════════════════════════════════════╗{RESET}",
        f"{BOLD}{CYAN}║{RESET}                                               {BOLD}{CYAN}║{RESET}",
        f"{BOLD}{CYAN}║{RESET}   {RED}{BOLD} _____  ____   ___    _     ____  ____{RESET}      {BOLD}{CYAN}║{RESET}",
        f"{BOLD}{CYAN}║{RESET}   {RED}{BOLD}|_   _||  _ \\ |_ _|  / \\   / ___||  __|{RESET}     {BOLD}{CYAN}║{RESET}",
        f"{BOLD}{CYAN}║{RESET}   {RED}{BOLD}  | |  | |_) | | |  / _ \\ | |  _ | |_{RESET}       {BOLD}{CYAN}║{RESET}",
        f"{BOLD}{CYAN}║{RESET}   {RED}{BOLD}  | |  |  _ <  | | / ___ \\| |_| ||  _|{RESET}      {BOLD}{CYAN}║{RESET}",
        f"{BOLD}{CYAN}║{RESET}   {RED}{BOLD}  |_|  |_| \\_\\|___/_/   \\_\\\\____||____|{RESET}     {BOLD}{CYAN}║{RESET}",
        f"{BOLD}{CYAN}║{RESET}                                               {BOLD}{CYAN}║{RESET}",
        f"{BOLD}{CYAN}║{RESET}          {BOLD}T H E   B O A R D   G A M E{RESET}          {BOLD}{CYAN}║{RESET}",
        f"{BOLD}{CYAN}║{RESET}                                               {BOLD}{CYAN}║{RESET}",
        f"{BOLD}{CYAN}╚═══════════════════════════════════════════════╝{RESET}",
    ]
    for line in centre_block(lines):
        print(line)
    print()
    print(centre_text(f"  {BOLD}[1]{RESET} Just a regular day"))
    print(centre_text(f"  {RED}{BOLD}[2]{RESET} Late for work!"))
    print()
    print(centre_text(f"  {DIM}Choose difficulty (1 or 2):{RESET}"))
    print()


def render_late_for_work_text():
    """Show the dramatic intro text for Late for Work mode."""
    clear_screen()
    print()
    text = (
        f"{RED}{BOLD}You are late for work!{RESET}\n\n"
        f"Your laziness may have killed someone already.\n"
        f"It's not good enough.\n\n"
        f"Is this what you trained for?\n"
        f"To lie about in bed while people were in pain?\n\n"
        f"{RED}Do Better!{RESET}\n"
    )
    for line in text.split('\n'):
        print(centre_text(f"  {line}"))
    print()
    print(centre_text(f"  {DIM}Press Enter to begin...{RESET}"))
    input()


