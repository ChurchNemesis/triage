    tutorial_enter("Press Enter to start walking Rae towards the exit")

    tutorial_rae("HANG ON!")
    tutorial_rae("Ok, Ok.. Ok.. OH.. Kay. Here… take this, it's just some notes in case you forget anything. Don't forget anything, but if you do forget something then remember to look for it here.")
    tutorial_rae("Good. Ok. Bye.")
    tutorial_rae("Call me if you need anything. Text to update me on Barry.")

    tutorial_enter("Press Enter to wave from the door of the hospital, nodding in a knowing and generous manner every time she looks back at you")

    # ══════════════════════════════════════════════════════════
    # STEP 13: Tutorial complete — Rae's note
    # ══════════════════════════════════════════════════════════
    clear_screen()
    print()
    W = 62
    B = f"{BOLD}{YELLOW}"
    E = RESET
    def note_row(text=""):
        if not text:
            return f"{B}║{E}{' ' * (W - 2)}{B}║{E}"
        vis = text
        while "\033[" in vis:
            start = vis.index("\033[")
            end = vis.index("m", start) + 1
            vis = vis[:start] + vis[end:]
        pad = max(0, W - 2 - 3 - len(vis))
        return f"{B}║{E}   {text}{' ' * pad}{B}║{E}"
    note_lines = [
        f"{B}╔{'═' * (W - 2)}╗{E}",
        note_row(),
        note_row(f"{BOLD}Rae's Notes:{E}"),
        note_row(),
        note_row("- Check in unchecked patients in the Waiting Room"),
        note_row("  (room action — press d)"),
        note_row(),
        note_row("- Send patients to the right diagnosis room —"),
        note_row("  Blood / Bone / Brain (press s)"),
        note_row(),
        note_row("- Diagnose patients by using the room action in a"),
        note_row("  diagnosis room (press d)"),
        note_row(),
        note_row("- Diagnosis can reveal complications — new symptoms"),
        note_row("  that need further treatment"),
        note_row(),
        note_row("- If there's harm, sound the alarm — send them to"),
        note_row("  Admittance to be admitted"),
        note_row(),
        note_row("- If no harm is there, show you care — discharge"),
        note_row("  them (send → confirm discharge)"),
        note_row(),
        note_row("- Room auto-functions process the front patient in"),
        note_row("  each room every turn"),
        note_row(),
        note_row("- Harm ticks every turn — the clock is always"),
        note_row("  against you"),
        note_row(),
        note_row("- Use P to change player - this doesn't cost an"),
        note_row("  action."),
        note_row(),
        note_row("In a real game, you'll have 3 staff members, 12"),
        note_row("actions per turn, and a steady stream of new"),
        note_row("arrivals over a 12-hour night shift. Keeping"),
        note_row("everyone alive means making hard choices about"),
        note_row("who to prioritise."),
        note_row(),
        note_row("You'll be a great hospital administrator -"),
        note_row("believe in yourself and don't fuck up."),
        note_row(),
        note_row(f"{BOLD}Good luck. Rae x.{E}"),
        note_row(),
        f"{B}╚{'═' * (W - 2)}╝{E}",
    ]
    for line in centre_block(note_lines):
        print(line)
    print()
    tutorial_enter("Press Enter to put it into your pocket")

    # Return to main menu


def run_interactive(seed=None):
    # Title screen menu loop
    late_for_work = False
    while True:
        render_title_screen()
        choice = input(f"  > ").strip().lower()
        if choice == "n":
            # Show difficulty selection for new game
            while True:
                render_difficulty_selection()
                diff_choice = input("  > ").strip().lower()
                if diff_choice == "1":
                    late_for_work = False
                    break
                elif diff_choice == "2":
                    late_for_work = True
                    render_late_for_work_text()
                    break
                else:
                    print(centre_text(f"  {RED}Choose 1 or 2.{RESET}"))
            break
        elif choice == "i":
            render_how_to_play()
        elif choice == "l":
            saves = list_save_files()
            if not saves:
                print(f"  {RED}No saved games found.{RESET}")
                continue
            print()
            print(f"  {BOLD}Saved Games:{RESET}")
            for i, (label, _) in enumerate(saves):
                print(f"    {BOLD}{i + 1}.{RESET} {label}")
            print()
            sel = input(f"  Load which save? (number, c = cancel): ").strip().lower()
            if sel == "c":
                continue
            try:
                idx = int(sel) - 1
                if 0 <= idx < len(saves):
                    _, fpath = saves[idx]
                    gs, active = load_game(fpath)
                    print(f"  {GREEN}Game loaded! Resuming at turn {gs.turn}...{RESET}")
                    time.sleep(1)
                    break
                else:
                    print(f"  {RED}Invalid choice.{RESET}")
            except (ValueError, Exception) as e:
                print(f"  {RED}Could not load save: {e}{RESET}")
        elif choice == "t":
            run_tutorial()
            continue
        elif choice == "q":
            print("  Goodbye.")
            return
        else:
            print(f"  {RED}Choose N, T, I, L, or Q.{RESET}")

    # Start a new game or resume a loaded one
    loaded = choice == "l"
    if not loaded:
        gs = create_game(seed=seed, late_for_work=late_for_work)
        active = 1

    # If loaded, resume the current turn's action phase first
    resume_mid_turn = loaded and gs.actions_remaining > 0
    start_turn = gs.turn if resume_mid_turn else (gs.turn + 1 if loaded else 1)

    for turn in range(start_turn, gs.total_turns + 1):
        if resume_mid_turn and turn == gs.turn:
            # Resuming mid-turn: skip begin_turn, just show state and continue actions
            render_full_state(gs)
        else:
            begin_turn(gs)
            render_full_state(gs)
 
        while gs.actions_remaining > 0:
            render_action_menu(gs, active)
            player = gs.players[active - 1]
            choice = input(f"  > ").strip().lower()
            action_taken = False
 
            if choice == "m":
                adj = ADJACENT[player.current_room]
                print(f"  Adjacent rooms: {', '.join(r.value for r in adj)}")
                target = input_room("Move to")
                if target is not None:
                    try:
                        msg = action_move(gs, player, target)
                        print(f"  {GREEN}{msg}{RESET}")
                        action_taken = True
                    except ActionError as e:
                        print(f"  {RED}{e}{RESET}")
                else:
                    print(f"  {DIM}Cancelled.{RESET}")
 
            elif choice == "d":
                # Universal room action
                if player.current_room == RoomType.WAITING:
                    try:
                        msg = action_check_in(gs, player)
                        print(f"  {GREEN}{msg}{RESET}")
                        action_taken = True
                    except ActionError as e:
                        print(f"  {RED}{e}{RESET}")
                elif player.current_room in ROOM_TO_SYMPTOM:
                    try:
                        msg = action_diagnose(gs, player)
                        print(f"  {GREEN}{msg}{RESET}")
                        action_taken = True
                    except ActionError as e:
                        print(f"  {RED}{e}{RESET}")
                elif player.current_room == RoomType.ADMITTANCE:
                    try:
                        msg = action_admit(gs, player)
                        print(f"  {GREEN}{msg}{RESET}")
                        action_taken = True
                    except ActionError as e:
                        print(f"  {RED}{e}{RESET}")
                else:
                    print(f"  {RED}No room action available here.{RESET}")
 
            elif choice == "s":
                room = gs.get_room(player.current_room)
                if not room.queue:
                    print(f"  {RED}No patients in this room.{RESET}")
                else:
                    pat = input_patient("Send which patient", room.queue)
                    if pat is None:
                        print(f"  {DIM}Cancelled.{RESET}")
                    elif pat.can_discharge:
                        yn = input(f"  {pat.name} can be discharged (0 harm). "
                                   f"Discharge? (y/n, c = cancel): ").strip().lower()
                        if yn == "y":
                            try:
                                print(f"  {GREEN}{action_send(gs, player, pat, None)}{RESET}")
                                action_taken = True
                            except ActionError as e:
                                print(f"  {RED}{e}{RESET}")
                        elif yn == "c":
                            print(f"  {DIM}Cancelled.{RESET}")
                        else:
                            target = input_room("Send to which room")
                            if target is not None:
                                try:
                                    print(f"  {GREEN}{action_send(gs, player, pat, target)}{RESET}")
                                    action_taken = True
                                except ActionError as e:
                                    print(f"  {RED}{e}{RESET}")
                            else:
                                print(f"  {DIM}Cancelled.{RESET}")
                    else:
                        target = input_room("Send to which room")
                        if target is not None:
                            try:
                                print(f"  {GREEN}{action_send(gs, player, pat, target)}{RESET}")
                                action_taken = True
                            except ActionError as e:
                                print(f"  {RED}{e}{RESET}")
                        else:
                            print(f"  {DIM}Cancelled.{RESET}")
 
            elif choice == "k":
                others = [p for r in gs.rooms.values()
                          if r.room_type != player.current_room for p in r.queue]
                if not others:
                    print(f"  {RED}No patients in other rooms to call.{RESET}")
                else:
                    pat = input_patient("Call which patient", others)
                    if pat is not None:
                        try:
                            print(f"  {GREEN}{action_call(gs, player, pat)}{RESET}")
                            action_taken = True
                        except ActionError as e:
                            print(f"  {RED}{e}{RESET}")
                    else:
                        print(f"  {DIM}Cancelled.{RESET}")
 
            elif choice == "r":
                room = gs.get_room(player.current_room)
                if len(room.queue) <= 1:
                    print(f"  {RED}Not enough patients to rearrange.{RESET}")
                else:
                    print(f"  Current queue in {player.current_room.value}:")
                    for i, p in enumerate(room.queue):
                        st = f"Sev {p.severity}" if p.checked_in else "???"
                        print(f"    {i + 1}. {p.name} ({st})")
                    print(f"  Enter new order as numbers separated by spaces "
                          f"(e.g., '3 1 2'), or c to cancel:")
                    try:
                        raw = input("  New order: ").strip()
                        if raw.lower() == "c":
                            print(f"  {DIM}Cancelled.{RESET}")
                        else:
                            indices = [int(x) - 1 for x in raw.split()]
                            if sorted(indices) == list(range(len(room.queue))):
                                new_order = [room.queue[i] for i in indices]
                                print(f"  {GREEN}{action_rearrange(gs, player, new_order)}{RESET}")
                                action_taken = True
                            else:
                                print(f"  {RED}Must include each position exactly once.{RESET}")
                    except (ValueError, IndexError, TypeError) as e:
                        print(f"  {RED}Invalid input: {e}{RESET}")
                    except ActionError as e:
                        print(f"  {RED}{e}{RESET}")
 
            elif choice == "p":
                print(f"  Players: {', '.join(f'P{p.id} @ {p.current_room.value}' for p in gs.players)}")
                try:
                    raw = input("  Switch to player # (c = cancel): ").strip()
                    if raw.lower() == "c":
                        print(f"  {DIM}Cancelled.{RESET}")
                    else:
                        pid = int(raw)
                        if 1 <= pid <= len(gs.players):
                            active = pid
                            print(f"  {GREEN}Now controlling Player {pid}.{RESET}")
                        else:
                            print(f"  {RED}Invalid player number.{RESET}")
                except ValueError:
                    print(f"  {RED}Invalid input.{RESET}")
 
            elif choice == "e":
                if input("  End turn and forfeit remaining actions? (y/n): ").strip().lower() == "y":
                    gs.actions_remaining = 0
 
            elif choice == "x":
                all_p = [p for r in gs.rooms.values() for p in r.queue]
                if not all_p:
                    print(f"  {RED}No patients to examine.{RESET}")
                else:
                    pat = input_patient("Examine which patient", all_p)
                    if pat is not None:
                        s = get_patient_status(gs, pat)
                        print(f"\n  {BOLD}=== {pat.name} ==={RESET}")
                        print(f"  Severity: {s['severity']}")
                        print(f"  Room: {s['room']}")
                        print(f"  Arrived: Turn {pat.arrival_turn} ({s['turns_since_arrival']} turns ago)")
                        print(f"  Harm Rate: {s['harm_rate']}")
                        print(f"  Cumulative Harm: {s['cumulative_harm']} / {s['health']}")
                        print(f"  Symptoms: {s['symptoms_diagnosed']}/{s['symptoms_total']} diagnosed")
                        print(f"  Fully Diagnosed: {s['fully_diagnosed']}")
                        if pat.ready_for_discharge_turn is not None:
                            tw = gs.turn - pat.ready_for_discharge_turn
                            tl = max(0, STORM_OUT_TURNS - tw)
                            print(f"  Discharge Ready: Yes ({tl} turns until storms out)")
                        if pat.checked_in:
                            print(f"  Symptom Cards:")
                            for card in pat.symptom_cards:
                                if card.face_up:
                                    print(f"    [{card.symptom_type.value}] DIAGNOSED: "
                                          f"harm +{card.harm_for_severity(pat.severity)}, "
                                          f"{card.complication_text}")
                                else:
                                    print(f"    [{card.symptom_type.value}] Undiagnosed")
                        print()
                    else:
                        print(f"  {DIM}Cancelled.{RESET}")
                        
            elif choice == "i":
                render_how_to_play()
                render_full_state(gs)
 
            elif choice == "v":
                try:
                    path = save_game(gs, active)
                    print(f"  {GREEN}Game saved successfully!{RESET}")
                    print(f"  {DIM}({path}){RESET}")
                except Exception as e:
                    print(f"  {RED}Save failed: {e}{RESET}")
 
            elif choice == "q":
                if input("  Quit the game? (y/n): ").strip().lower() == "y":
                    print("  Game abandoned.")
                    return
            else:
                print(f"  {RED}Unknown action. Use m/d/s/k/r/p/e/x/i/v/q.{RESET}")
 
            if action_taken:
                render_full_state(gs)
 
        # End of turn
        print(f"\n  {BOLD}End of turn -- room auto-functions activating...{RESET}")
        log_before = len(gs.log)
        end_turn(gs)
        for entry in gs.log[log_before:]:
            if entry.startswith("[Auto]"):
                print(f"  {YELLOW}{entry}{RESET}")
        print(f"\n  Press Enter to continue to next turn...")
        input()
 
        # End-of-game audit sequence (dramatic patient-by-patient tally)
    render_audit_sequence(gs)
    result = resolve_end_of_game(gs)
    render_end_of_game(gs, result)
 
 
# ═══════════════════════════════════════════════════════════════
# AI PLAYER
# ═══════════════════════════════════════════════════════════════
 
def get_priority_symptom(patient):
    counts = {}
    for c in patient.symptom_cards:
        if not c.face_up:
            counts[c.symptom_type] = counts.get(c.symptom_type, 0) + 1
    return max(counts, key=counts.get) if counts else None
 
 
def ai_decide_action(gs, player_idx):
    player = gs.players[player_idx]
 
    # Priority 1: Discharge / admit fully diagnosed in current room
    room = gs.get_room(player.current_room)
    for pat in list(room.queue):
        if not pat.checked_in or not pat.is_fully_diagnosed:
            continue
        if pat.can_discharge:
            try:
                action_send(gs, player, pat, None)
                return True
            except ActionError:
                pass
        elif pat.needs_admittance and not gs.get_room(RoomType.ADMITTANCE).is_full:
            try:
                action_send(gs, player, pat, RoomType.ADMITTANCE)
                return True
            except ActionError:
                pass
 
    # Priority 2: Room action in current room
    if player.current_room in ROOM_TO_SYMPTOM:
        stype = ROOM_TO_SYMPTOM[player.current_room]
        dr = gs.get_room(player.current_room)
        if dr.queue:
            front = dr.queue[0]
            if front.checked_in and any(not c.face_up and c.symptom_type == stype
                                        for c in front.symptom_cards):
                try:
                    action_diagnose(gs, player)
                    return True
                except ActionError:
                    pass
    elif player.current_room == RoomType.ADMITTANCE:
        admittance = gs.get_room(RoomType.ADMITTANCE)
        if admittance.queue:
            try:
                action_admit(gs, player)
                return True
            except ActionError:
                pass
 
    # Priority 3: Route patients from waiting room
    if player.current_room == RoomType.WAITING:
        waiting = gs.get_room(RoomType.WAITING)
        for pat in list(waiting.queue):
            if not pat.checked_in or not pat.is_fully_diagnosed:
                continue
            if pat.can_discharge:
                try:
                    action_send(gs, player, pat, None)
                    return True
                except ActionError:
                    pass
            elif pat.needs_admittance and not gs.get_room(RoomType.ADMITTANCE).is_full:
                try:
                    action_send(gs, player, pat, RoomType.ADMITTANCE)
                    return True
                except ActionError:
                    pass
        for pat in list(waiting.queue):
            if not pat.checked_in or pat.is_fully_diagnosed:
                continue
            pt = get_priority_symptom(pat)
            if pt and not gs.get_room(SYMPTOM_TO_ROOM[pt]).is_full:
                try:
                    action_send(gs, player, pat, SYMPTOM_TO_ROOM[pt])
                    return True
                except ActionError:
                    pass
        if any(not p.checked_in for p in waiting.queue):
            try:
                action_check_in(gs, player)
                return True
            except ActionError:
                pass
 
    # Priority 4: Move to most useful room
    best_room, best_score = None, -1
    for tt in [RoomType.WAITING, RoomType.BLOOD, RoomType.BONE,
               RoomType.BRAIN, RoomType.ADMITTANCE]:
        score = 0
        if tt == RoomType.WAITING:
            w = gs.get_room(RoomType.WAITING)
            score = (sum(1 for p in w.queue if not p.checked_in) * 3 +
                     sum(1 for p in w.queue if p.checked_in and not p.is_fully_diagnosed) * 2 +
                     sum(1 for p in w.queue if p.checked_in and p.is_fully_diagnosed) * 4)
        elif tt in ROOM_TO_SYMPTOM:
            dr = gs.get_room(tt)
            score = sum(p.severity * 2 for p in dr.queue if p.checked_in)
            st = ROOM_TO_SYMPTOM[tt]
            w = gs.get_room(RoomType.WAITING)
            score += sum(p.severity for p in w.queue
                         if p.checked_in and any(not c.face_up and c.symptom_type == st
                                                  for c in p.symptom_cards))
        elif tt == RoomType.ADMITTANCE:
            ad = gs.get_room(RoomType.ADMITTANCE)
            score = len(ad.queue) * 3
        players_there = sum(1 for pl in gs.players if pl.current_room == tt)
        if tt == player.current_room:
            score -= 5
        score -= players_there * 2
        if score > best_score:
            best_score, best_room = score, tt
 
    if best_room and best_room != player.current_room:
        if best_room in ADJACENT[player.current_room]:
            try:
                action_move(gs, player, best_room)
                return True
            except ActionError:
                pass
        elif player.current_room != RoomType.WAITING:
            try:
                action_move(gs, player, RoomType.WAITING)
                return True
            except ActionError:
                pass
 
    # Priority 5: Rearrange queues
    room = gs.get_room(player.current_room)
    if len(room.queue) >= 2:
        checked = [p for p in room.queue if p.checked_in]
        if len(checked) >= 2:
            sq = sorted(room.queue, key=lambda p: (
                -p.severity if p.checked_in else 0,
                -p.cumulative_harm(gs.turn) if p.checked_in else 0))
            if sq != room.queue:
                try:
                    action_rearrange(gs, player, sq)
                    return True
                except ActionError:
                    pass
 
    return False
 
 
def ai_play_turn(gs):
    limit = gs.actions_remaining * 3
    for _ in range(limit):
        if gs.actions_remaining <= 0:
            break
        if not any(ai_decide_action(gs, i) for i in range(len(gs.players))):
            break
 
 
# ═══════════════════════════════════════════════════════════════
# SIMULATION MODE
# ═══════════════════════════════════════════════════════════════
 
def run_single_game(seed=None, verbose=False):
    gs = create_game(seed=seed)
    for turn in range(1, gs.total_turns + 1):
        begin_turn(gs)
        if verbose:
            print(f"  Turn {turn}: {len(gs.all_patients)} patients, "
                  f"WR={gs.get_room(RoomType.WAITING).patient_count}, "
                  f"BL={gs.get_room(RoomType.BLOOD).patient_count}, "
                  f"BO={gs.get_room(RoomType.BONE).patient_count}, "
                  f"BR={gs.get_room(RoomType.BRAIN).patient_count}, "
                  f"AD={gs.get_room(RoomType.ADMITTANCE).patient_count}")
        ai_play_turn(gs)
        end_turn(gs)
    result = resolve_end_of_game(gs)
    if verbose:
        print(f"  Result: {'WIN' if result['won'] else 'LOSS'} -- {result['death_count']} deaths, "
              f"{result['discharged']} discharged, {result['admitted']} admitted")
    return result
 
 
def run_simulation(num_games=100, base_seed=None, verbose=False):
    if base_seed is None:
        base_seed = random.randint(0, 999999)
    wins = 0
    deaths_list, discharged_list, admitted_list, patients_list, stormed_list = [], [], [], [], []
 
    print(f"\nTRIAGE: The Board Game -- Simulation Mode")
    print(f"{'=' * 50}")
    print(f"  Games: {num_games}")
    print(f"  Settings: {NUM_PLAYERS} players, {ACTIONS_PER_PLAYER} actions each, {TOTAL_TURNS} turns")
    print(f"  Arrivals: curve {ARRIVAL_CURVE}, Health: {PATIENT_HEALTH}, "
          f"Death threshold: {DEATH_THRESHOLD}")
    print(f"  Base seed: {base_seed}")
    print(f"{'=' * 50}")
 
    for i in range(num_games):
        r = run_single_game(seed=base_seed + i, verbose=verbose)
        if r["won"]:
            wins += 1
        deaths_list.append(r["death_count"])
        discharged_list.append(r["discharged"])
        admitted_list.append(r["admitted"])
        patients_list.append(r["total_patients"])
        stormed_list.append(r["stormed_out"])
        if (i + 1) % 10 == 0 or i == num_games - 1:
            sys.stdout.write(f"\r  Progress: {i + 1}/{num_games} "
                             f"({(i + 1) / num_games * 100:.0f}%)")
            sys.stdout.flush()
 
    print("\n")
    avg_d = sum(deaths_list) / len(deaths_list)
    wr = wins / num_games * 100
    dd = {}
    for d in deaths_list:
        dd[d] = dd.get(d, 0) + 1
 
    print(f"Results:")
    print(f"{'-' * 50}")
    print(f"  Win rate:           {wr:.1f}% ({wins}/{num_games})")
    print(f"  Avg deaths:         {avg_d:.2f}")
    print(f"  Death range:        {min(deaths_list)}-{max(deaths_list)}")
    print(f"  Avg discharged:     {sum(discharged_list) / len(discharged_list):.2f}")
    print(f"  Avg admitted:       {sum(admitted_list) / len(admitted_list):.2f}")
    print(f"  Avg stormed out:    {sum(stormed_list) / len(stormed_list):.2f}")
    print(f"  Avg total patients: {sum(patients_list) / len(patients_list):.1f}")
    print()
    print(f"  Death distribution:")
    for d in sorted(dd):
        cnt = dd[d]
        bar = '#' * (cnt * 40 // num_games)
        marker = " <-- threshold" if d == DEATH_THRESHOLD else ""
        print(f"    {d:2d} deaths: {bar} {cnt / num_games * 100:.1f}% ({cnt}){marker}")
    print()
    if wr > 60:
        print(f"  -> Game may be too easy. Consider: more arrivals, less health, fewer actions.")
    elif wr < 20:
        print(f"  -> Game may be too hard. Consider: fewer arrivals, more health, more actions.")
    elif 30 <= wr <= 50:
        print(f"  -> Difficulty looks good! Most games are close.")
    else:
        print(f"  -> Difficulty is in a reasonable range. Fine-tune with variables above.")
 
 
# ═══════════════════════════════════════════════════════════════
# MAIN ENTRY POINT
# ═══════════════════════════════════════════════════════════════
 
def main():
    global NUM_PLAYERS, ACTIONS_PER_PLAYER, TOTAL_TURNS, ARRIVALS_PER_TURN
    global PATIENT_HEALTH, DEATH_THRESHOLD, ROOM_CAPACITY
 
    parser = argparse.ArgumentParser(
        description="TRIAGE: The Board Game -- Digital Simulation",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python triage.py                         Interactive mode
  python triage.py --mode simulate         Run 100 simulated games
  python triage.py --mode simulate -n 500  Run 500 simulated games
  python triage.py --seed 42               Reproducible game
  python triage.py --mode simulate -v      Verbose simulation
""",
    )
    parser.add_argument("--mode", choices=["interactive", "simulate"], default="interactive")
    parser.add_argument("-n", "--num-games", type=int, default=100)
    parser.add_argument("-s", "--seed", type=int, default=None)
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--players", type=int, default=None)
    parser.add_argument("--actions", type=int, default=None)
    parser.add_argument("--turns", type=int, default=None)
    parser.add_argument("--arrivals", type=int, default=None)
    parser.add_argument("--health", type=int, default=None)
    parser.add_argument("--deaths", type=int, default=None)
    parser.add_argument("--capacity", type=int, default=None)
    args = parser.parse_args()
 
    if args.players is not None:
        NUM_PLAYERS = args.players
    if args.actions is not None:
        ACTIONS_PER_PLAYER = args.actions
    if args.turns is not None:
        TOTAL_TURNS = args.turns
    if args.arrivals is not None:
        ARRIVALS_PER_TURN = args.arrivals
    if args.health is not None:
        PATIENT_HEALTH = args.health
    if args.deaths is not None:
        DEATH_THRESHOLD = args.deaths
    if args.capacity is not None:
        ROOM_CAPACITY = args.capacity
 
    if args.mode == "interactive":
        run_interactive(seed=args.seed)
    else:
        run_simulation(num_games=args.num_games, base_seed=args.seed, verbose=args.verbose)
 
 
if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"\n{RED}{BOLD}ERROR: {e}{RESET}")
        import traceback
        traceback.print_exc()
        input("Press Enter to close...")
