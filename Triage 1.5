#!/usr/bin/env python3
"""
TRIAGE: The Board Game — Digital Simulation (Single-File Edition)
 
A cooperative board game about running an overnight A&E department.
1-3 players work together to survive a night shift.
 
Usage:
    python triage.py                         Interactive mode
    python triage.py --mode simulate         Run 100 AI-simulated games
    python triage.py --mode simulate -n 500  Simulate 500 games
    python triage.py --seed 42               Reproducible game
    python triage.py --mode simulate -v      Verbose simulation
"""
