def _weighted_choice(table):
    r = random.random()
    cumulative = 0.0
    for row in table:
        cumulative += row[0]
        if r <= cumulative:
            return row
    return table[-1]
 
 
def generate_symptom_deck(symptom_type: SymptomType, size: int = None) -> list:
    if size is None:
        size = SYMPTOM_DECK_SIZE
    deck = []
    for _ in range(size):
        harm_row = _weighted_choice(SYMPTOM_HARM_TABLE)
        harm_values = (harm_row[1], harm_row[2], harm_row[3])
        comp_row = _weighted_choice(SYMPTOM_COMPLICATION_TABLE)
        complications = [(symptom_type.type_by_offset(off), cnt) for off, cnt in comp_row[1]]
        deck.append(SymptomCard(symptom_type, harm_values, complications))
    random.shuffle(deck)
    return deck
 
 
def draw_symptom_card(deck, discard, symptom_type):
    if not deck:
        deck.extend(discard)
        discard.clear()
        random.shuffle(deck)
    if not deck:
        return generate_symptom_deck(symptom_type, 1)[0]
    card = deck.pop(0)
    return SymptomCard(card.symptom_type, card.harm_values, list(card.complications))
 
 
def generate_patient_deck(total=None):
    if total is None:
        total = TOTAL_PATIENTS
    names = list(FIRST_NAMES)
    random.shuffle(names)
    while len(names) < total:
        names.append(f"Patient #{len(names) + 1}")
    patients = []
    severities = [1, 2, 3]
    sev_probs = [SEVERITY_WEIGHTS[s] for s in severities]
    stypes = [SymptomType.BLOOD, SymptomType.BONE, SymptomType.BRAIN]
    for i in range(total):
        sev = random.choices(severities, weights=sev_probs, k=1)[0]
        if random.random() < SINGLE_SYMPTOM_RATIO:
            init_symp = [random.choice(stypes)]
        elif random.random() < MULTI_SYMPTOM_2_RATIO:
            init_symp = random.choices(stypes, k=2)
        else:
            init_symp = random.choices(stypes, k=3)
        patients.append(Patient(id=i + 1, name=names[i], severity=sev, initial_symptoms=init_symp))
    random.shuffle(patients)
    return patients
 
 
# ═══════════════════════════════════════════════════════════════
# GAME ENGINE
# ═══════════════════════════════════════════════════════════════
 
class ActionError(Exception):
    pass
 
 
@dataclass
class GameState:
    turn: int = 0
    total_turns: int = TOTAL_TURNS
    rooms: dict = field(default_factory=dict)
    players: list = field(default_factory=list)
    actions_remaining: int = 0
    patient_deck: list = field(default_factory=list)
    symptom_decks: dict = field(default_factory=dict)
    symptom_discards: dict = field(default_factory=dict)
    all_patients: list = field(default_factory=list)
    log: list = field(default_factory=list)
 
    @property
    def shift_hour(self) -> str:
        h = (SHIFT_START_HOUR + self.turn) % 24
        if h == 0: return "12:00 AM"
        if h < 12: return f"{h}:00 AM"
        if h == 12: return "12:00 PM"
        return f"{h - 12}:00 PM"
 
    def get_room(self, rt: RoomType) -> Room:
        return self.rooms[rt]
 
    def find_patient_room(self, patient: Patient) -> Optional[Room]:
        for room in self.rooms.values():
            if patient in room.queue:
                return room
        return None
 
 
def create_game(seed=None):
    if seed is not None:
        random.seed(seed)
    gs = GameState()
    gs.rooms = {
        RoomType.WAITING: Room(RoomType.WAITING, capacity=None),
        RoomType.BLOOD: Room(RoomType.BLOOD, capacity=ROOM_CAPACITY),
        RoomType.BONE: Room(RoomType.BONE, capacity=ROOM_CAPACITY),
        RoomType.BRAIN: Room(RoomType.BRAIN, capacity=ROOM_CAPACITY),
        RoomType.ADMITTANCE: Room(RoomType.ADMITTANCE, capacity=ROOM_CAPACITY),
    }
    gs.players = [Player(id=i + 1) for i in range(NUM_PLAYERS)]
    gs.patient_deck = generate_patient_deck()
    for st in SymptomType:
        gs.symptom_decks[st] = generate_symptom_deck(st)
        gs.symptom_discards[st] = []
    gs.actions_remaining = NUM_PLAYERS * ACTIONS_PER_PLAYER
    return gs
 
 
def _draw(gs, symptom_type):
    return draw_symptom_card(gs.symptom_decks[symptom_type],
                             gs.symptom_discards[symptom_type], symptom_type)
 
 
def assign_symptom_cards(gs, patient):
    for stype in patient.initial_symptoms:
        patient.symptom_cards.append(_draw(gs, stype))
 
 
def _diagnose_card(gs, patient, card):
    """Flip a card and handle complications. Returns harm value."""
    card.face_up = True
    harm = card.harm_for_severity(patient.severity)
    for comp_type, comp_count in card.complications:
        for _ in range(comp_count):
            patient.symptom_cards.append(_draw(gs, comp_type))
    return harm
 
 
def check_patient_deaths(gs):
    """Track when patients first die (visible cumulative harm >= health)."""
    for patient in gs.all_patients:
        if patient.discharged or patient.admitted:
            continue
        if patient.death_turn is not None:
            continue
        if patient.checked_in and patient.cumulative_harm(gs.turn) >= PATIENT_HEALTH:
            patient.death_turn = gs.turn
 
 
# ── Player Actions ──
 
def action_move(gs, player, target_room):
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    if target_room not in ADJACENT[player.current_room]:
        raise ActionError(f"Cannot move directly from {player.current_room.value} to "
                          f"{target_room.value}. Must pass through Waiting Room.")
    old = player.current_room
    player.current_room = target_room
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = f"Player {player.id} moved from {old.value} to {target_room.value}."
    gs.log.append(msg)
    return msg
 
 
def action_check_in(gs, player):
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    if player.current_room != RoomType.WAITING:
        raise ActionError("Must be in the Waiting Room to check in patients.")
    waiting = gs.get_room(RoomType.WAITING)
    target = next((p for p in waiting.queue if not p.checked_in), None)
    if target is None:
        raise ActionError("No unchecked patients in the Waiting Room.")
    target.checked_in = True
    assign_symptom_cards(gs, target)
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = (f"Player {player.id} checked in {target.name} (Severity {target.severity}, "
           f"{len(target.symptom_cards)} symptom{'s' if len(target.symptom_cards) != 1 else ''}: "
           f"{', '.join(c.symptom_type.value for c in target.symptom_cards)}).")
    gs.log.append(msg)
    return msg
 
 
def action_diagnose(gs, player):
    """Diagnose up to 2 matching symptom cards on front-of-queue patient."""
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    rt = player.current_room
    if rt not in ROOM_TO_SYMPTOM:
        raise ActionError(f"Cannot diagnose in {rt.value}.")
    stype = ROOM_TO_SYMPTOM[rt]
    room = gs.get_room(rt)
    if not room.queue:
        raise ActionError(f"No patients in {rt.value}.")
    patient = room.queue[0]
    if not patient.checked_in:
        raise ActionError(f"{patient.name} has not been checked in yet.")
    matching = [c for c in patient.symptom_cards if not c.face_up and c.symptom_type == stype]
    if not matching:
        raise ActionError(f"{patient.name} has no undiagnosed {stype.value} symptoms.")
    # Diagnose up to 2 matching cards
    diagnosed = []
    for card in matching[:2]:
        harm = _diagnose_card(gs, patient, card)
        diagnosed.append((card, harm))
    room.remove_patient(patient)
    gs.get_room(RoomType.WAITING).add_patient(patient)
    gs.actions_remaining -= 1
    player.action_count += 1
    if len(diagnosed) == 1:
        card, harm = diagnosed[0]
        msg = (f"Player {player.id} diagnosed {patient.name}'s {stype.value} symptom: "
               f"harm +{harm} (sev {patient.severity}). {card.complication_text}. "
               f"Patient returned to Waiting Room.")
    else:
        total_harm = sum(h for _, h in diagnosed)
        comps = "; ".join(c.complication_text for c, _ in diagnosed)
        msg = (f"Player {player.id} diagnosed 2 of {patient.name}'s {stype.value} symptoms: "
               f"total harm +{total_harm} (sev {patient.severity}). {comps}. "
               f"Patient returned to Waiting Room.")
    gs.log.append(msg)
    return msg
 
 
def action_admit(gs, player):
    """Transfer front patient out of game from Admittance room."""
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    if player.current_room != RoomType.ADMITTANCE:
        raise ActionError("Must be in Admittance to transfer patients.")
    admittance = gs.get_room(RoomType.ADMITTANCE)
    if not admittance.queue:
        raise ActionError("No patients in Admittance.")
    patient = admittance.queue[0]
    admittance.remove_patient(patient)
    patient.admitted = True
    patient.admitted_turn = gs.turn
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = f"Player {player.id} transferred {patient.name} out from Admittance."
    gs.log.append(msg)
    return msg
 
 
def action_send(gs, player, patient, target_room):
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    current = gs.get_room(player.current_room)
    if patient not in current.queue:
        raise ActionError(f"{patient.name} is not in {player.current_room.value}.")
    # Explicit discharge request (target_room is None)
    if target_room is None:
        if not patient.can_discharge:
            raise ActionError(f"{patient.name} cannot be discharged yet.")
        current.remove_patient(patient)
        patient.discharged = True
        patient.discharge_turn = gs.turn
        gs.actions_remaining -= 1
        player.action_count += 1
        msg = f"Player {player.id} discharged {patient.name} (0 harm, fully diagnosed)."
        gs.log.append(msg)
        return msg
    target = gs.get_room(target_room)
    if target.is_full:
        raise ActionError(f"{target_room.value} is full ({target.capacity} patients).")
    current.remove_patient(patient)
    target.add_patient(patient)
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = f"Player {player.id} sent {patient.name} to {target_room.value}."
    gs.log.append(msg)
    return msg
 
 
def action_call(gs, player, patient):
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    player_room = gs.get_room(player.current_room)
    if player_room.is_full:
        raise ActionError(f"{player.current_room.value} is full.")
    source = gs.find_patient_room(patient)
    if source is None:
        raise ActionError(f"{patient.name} is not in any room.")
    if source.room_type == player.current_room:
        raise ActionError(f"{patient.name} is already in {player.current_room.value}.")
    source.remove_patient(patient)
    player_room.add_patient(patient)
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = f"Player {player.id} called {patient.name} from {source.room_type.value} to {player.current_room.value}."
    gs.log.append(msg)
    return msg
 
 
def action_rearrange(gs, player, new_order):
    if gs.actions_remaining <= 0:
        raise ActionError("No actions remaining.")
    room = gs.get_room(player.current_room)
    if set(new_order) != set(room.queue):
        raise ActionError("New order must contain exactly the same patients.")
    room.queue = list(new_order)
    gs.actions_remaining -= 1
    player.action_count += 1
    msg = f"Player {player.id} rearranged {player.current_room.value} queue: {', '.join(p.name for p in new_order)}."
    gs.log.append(msg)
    return msg
 
 
# ── Turn Phases ──
 
def phase_arrivals(gs):
    if gs.turn >= gs.total_turns:
        return
    count = ARRIVALS_PER_TURN
    if ARRIVAL_CURVE is not None:
        idx = gs.turn - 1
        if 0 <= idx < len(ARRIVAL_CURVE):
            count = ARRIVAL_CURVE[idx]
    waiting = gs.get_room(RoomType.WAITING)
    arrived = []
    for _ in range(count):
        if not gs.patient_deck:
            break
        p = gs.patient_deck.pop(0)
        p.arrival_turn = gs.turn
        waiting.add_patient(p)
        gs.all_patients.append(p)
        arrived.append(p.name)
    if arrived:
        gs.log.append(f"New arrivals: {', '.join(arrived)} ({len(arrived)} patients).")
    else:
        gs.log.append("No new arrivals (patient deck empty).")
 
 
def phase_auto_functions(gs):
    waiting = gs.get_room(RoomType.WAITING)
 
    # Auto check-in
    for patient in waiting.queue:
        if not patient.checked_in:
            patient.checked_in = True
            assign_symptom_cards(gs, patient)
            gs.log.append(f"[Auto] Waiting Room checked in {patient.name} "
                          f"(Severity {patient.severity}, "
                          f"{len(patient.symptom_cards)} symptoms: "
                          f"{', '.join(c.symptom_type.value for c in patient.symptom_cards)}).")
            break
 
    # Auto diagnose (up to 2 matching symptoms per room)
    for rt in [RoomType.BLOOD, RoomType.BONE, RoomType.BRAIN]:
        room = gs.get_room(rt)
        if not room.queue:
            continue
        patient = room.queue[0]
        if not patient.checked_in:
            continue
        stype = ROOM_TO_SYMPTOM[rt]
        matching = [c for c in patient.symptom_cards if not c.face_up and c.symptom_type == stype]
        if not matching:
            continue
        diagnosed = []
        for card in matching[:2]:
            harm = _diagnose_card(gs, patient, card)
            diagnosed.append((card, harm))
        room.remove_patient(patient)
        waiting.add_patient(patient)
        if len(diagnosed) == 1:
            card, harm = diagnosed[0]
            gs.log.append(f"[Auto] {rt.value} diagnosed {patient.name}'s {stype.value}: "
                          f"harm +{harm}. {card.complication_text}. Returned to Waiting Room.")
        else:
            total_harm = sum(h for _, h in diagnosed)
            gs.log.append(f"[Auto] {rt.value} diagnosed {len(diagnosed)} of {patient.name}'s "
                          f"{stype.value} symptoms: total harm +{total_harm}. "
                          f"Returned to Waiting Room.")
 
    # Auto admittance
    admittance = gs.get_room(RoomType.ADMITTANCE)
    if admittance.queue:
        patient = admittance.queue[0]
        admittance.remove_patient(patient)
        patient.admitted = True
        patient.admitted_turn = gs.turn
        gs.log.append(f"[Auto] Admittance transferred {patient.name} out of the game.")
 
    # Tag newly discharge-ready patients
    for room in gs.rooms.values():
        for patient in room.queue:
            if (patient.checked_in and patient.can_discharge
                    and patient.ready_for_discharge_turn is None):
                patient.ready_for_discharge_turn = gs.turn
 
    # Auto storm-out: patients who have waited too long after becoming discharge-ready
    for room in gs.rooms.values():
        for patient in list(room.queue):
            if patient.ready_for_discharge_turn is None:
                continue
            if not patient.can_discharge:
                continue
            turns_waiting = gs.turn - patient.ready_for_discharge_turn
            if turns_waiting >= STORM_OUT_TURNS:
                room.remove_patient(patient)
                patient.discharged = True
                patient.stormed_out = True
                patient.discharge_turn = gs.turn
                gs.log.append(f"[Auto] {patient.name} stormed out! "
                              f"(waited {turns_waiting} turns after being ready for discharge)")
 
 
def begin_turn(gs):
    gs.turn += 1
    gs.actions_remaining = NUM_PLAYERS * ACTIONS_PER_PLAYER
    gs.log.append(f"\n{'=' * 50}")
    gs.log.append(f"TURN {gs.turn} of {gs.total_turns} -- {gs.shift_hour}")
    gs.log.append(f"{'=' * 50}")
    gs.log.append("Harm tick: all patients accumulate damage.")
    # Check for newly dead patients after harm tick
    check_patient_deaths(gs)
    if gs.turn < gs.total_turns:
        phase_arrivals(gs)
    else:
        gs.log.append("Final turn -- no new arrivals.")
 
 
def end_turn(gs):
    phase_auto_functions(gs)
    check_patient_deaths(gs)
 
 
def resolve_end_of_game(gs):
    # Check in all remaining
    for room in gs.rooms.values():
        for patient in room.queue:
            if not patient.checked_in:
                patient.checked_in = True
                assign_symptom_cards(gs, patient)
    # Diagnose all (resolve cascades)
    for _ in range(1000):
        found = False
        for patient in gs.all_patients:
            if patient.discharged or patient.admitted:
                continue
            for card in patient.symptom_cards:
                if not card.face_up:
                    _diagnose_card(gs, patient, card)
                    found = True
                    break
            if found:
                break
        if not found:
            break
    # Count deaths
    deaths, survivors = [], []
    for patient in gs.all_patients:
        if patient.discharged or patient.admitted:
            survivors.append(patient)
            continue
        if patient.cumulative_harm_total(gs.total_turns) >= PATIENT_HEALTH:
            deaths.append(patient)
        else:
            survivors.append(patient)
    return {
        "deaths": deaths,
        "death_count": len(deaths),
        "survivors": survivors,
        "won": len(deaths) <= DEATH_THRESHOLD,
        "total_patients": len(gs.all_patients),
        "discharged": sum(1 for p in gs.all_patients if p.discharged),
        "admitted": sum(1 for p in gs.all_patients if p.admitted),
        "stormed_out": sum(1 for p in gs.all_patients if p.stormed_out),
    }
 
 
def get_patient_status(gs, patient):
    harm = patient.cumulative_harm(gs.turn) if patient.checked_in else 0
    turns = gs.turn - patient.arrival_turn if patient.arrival_turn else 0
    return {
        "name": patient.name,
        "severity": patient.severity if patient.checked_in else "?",
        "checked_in": patient.checked_in,
        "room": patient.current_room.value if patient.current_room else "None",
        "harm_rate": patient.harm_rate if patient.checked_in else "?",
        "cumulative_harm": harm,
        "health": PATIENT_HEALTH,
        "turns_since_arrival": turns,
        "symptoms_total": len(patient.symptom_cards) if patient.checked_in else "?",
        "symptoms_diagnosed": sum(1 for c in patient.symptom_cards if c.face_up) if patient.checked_in else 0,
        "symptoms_remaining": len(patient.undiagnosed_cards) if patient.checked_in else "?",
        "fully_diagnosed": patient.is_fully_diagnosed if patient.checked_in else False,
        "is_dead": harm >= PATIENT_HEALTH if patient.checked_in else False,
    }
 
 
