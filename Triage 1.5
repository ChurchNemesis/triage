# CONFIGURATION — All tunable game variables
# ═══════════════════════════════════════════════════════════════
 
DEATH_THRESHOLD = 2
TOTAL_TURNS = 12
NUM_PLAYERS = 3
ACTIONS_PER_PLAYER = 4
ARRIVALS_PER_TURN = 4  # fallback; ARRIVAL_CURVE overrides per-turn
ARRIVAL_CURVE = [4, 4, 4, 4, 3, 3, 3, 3, 2, 2, 2, 2]
TOTAL_PATIENTS = 36
PATIENT_HEALTH = 36
SEVERITY_WEIGHTS = {1: 0.45, 2: 0.40, 3: 0.15}
BRANCHING_FACTOR = 0.72
SYMPTOM_DECK_SIZE = 60
ROOM_CAPACITY = 5
SINGLE_SYMPTOM_RATIO = 0.75
MULTI_SYMPTOM_2_RATIO = 0.80
SHIFT_START_HOUR = 20  # 8:00 PM
STORM_OUT_TURNS = 4    # turns before discharge-ready patients storm out
 
# Harm table: (probability, sev1_harm, sev2_harm, sev3_harm)
# Slight bump to severity 1 and 2 compared to original
SYMPTOM_HARM_TABLE = [
    (0.30, 0, 0, 0),
    (0.20, 0, 0, 1),
    (0.15, 0, 1, 1),
    (0.12, 1, 1, 2),   # sev1: 0->1
    (0.10, 0, 1, 2),   # sev2: 0->1
    (0.05, 1, 1, 2),
    (0.04, 0, 1, 3),
    (0.02, 1, 2, 3),
    (0.01, 0, 2, 3),
    (0.01, 1, 2, 4),
]
 
SYMPTOM_COMPLICATION_TABLE = [
    (0.40, []),
    (0.20, [(0, 1)]),
    (0.10, [(1, 1)]),
    (0.10, [(2, 1)]),
    (0.10, [(0, 2)]),
    (0.04, [(0, 1), (1, 1)]),
    (0.04, [(0, 1), (2, 1)]),
    (0.02, [(0, 3)]),
]
 
 
