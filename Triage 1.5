    if result["deaths"]:
        print(f"  {RED}{BOLD}Patients lost:{RESET}")
        for p in result["deaths"]:
            th = p.cumulative_harm_total(gs.total_turns)
            print(f"    - {p.name} (Sev {p.severity}, harm rate {p.total_harm_rate}, "
                  f"total harm {th}/{PATIENT_HEALTH}, arrived turn {p.arrival_turn})")
        print()
    remaining = [p for p in result["survivors"] if not p.discharged and not p.admitted]
    if remaining:
        print(f"  {GREEN}Surviving patients still in hospital:{RESET}")
        for p in remaining:
            th = p.cumulative_harm_total(gs.total_turns)
            print(f"    - {p.name} (Sev {p.severity}, total harm {th}/{PATIENT_HEALTH})")
        print()
 
 
