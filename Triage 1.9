def _weighted_choice(table):
    r = random.random()
    cumulative = 0.0
    for row in table:
        cumulative += row[0]
        if r <= cumulative:
            return row
    return table[-1]
 
 
def generate_symptom_deck(symptom_type: SymptomType, size: int = None) -> list:
    if size is None:
        size = SYMPTOM_DECK_SIZE
    deck = []
    for _ in range(size):
        harm_row = _weighted_choice(SYMPTOM_HARM_TABLE)
        harm_values = (harm_row[1], harm_row[2], harm_row[3])
        comp_row = _weighted_choice(SYMPTOM_COMPLICATION_TABLE)
        complications = [(symptom_type.type_by_offset(off), cnt) for off, cnt in comp_row[1]]
        deck.append(SymptomCard(symptom_type, harm_values, complications))
    random.shuffle(deck)
    return deck
 
 
def draw_symptom_card(deck, discard, symptom_type):
    if not deck:
        deck.extend(discard)
        discard.clear()
        random.shuffle(deck)
    if not deck:
        return generate_symptom_deck(symptom_type, 1)[0]
    card = deck.pop(0)
    return SymptomCard(card.symptom_type, card.harm_values, list(card.complications))
 
 
def generate_patient_deck(total=None):
    if total is None:
        total = TOTAL_PATIENTS
    names = list(FIRST_NAMES)
    random.shuffle(names)
    while len(names) < total:
        names.append(f"Patient #{len(names) + 1}")
    patients = []
    severities = [1, 2, 3]
    sev_probs = [SEVERITY_WEIGHTS[s] for s in severities]
    stypes = [SymptomType.BLOOD, SymptomType.BONE, SymptomType.BRAIN]
    for i in range(total):
        sev = random.choices(severities, weights=sev_probs, k=1)[0]
        if random.random() < SINGLE_SYMPTOM_RATIO:
            init_symp = [random.choice(stypes)]
        elif random.random() < MULTI_SYMPTOM_2_RATIO:
            init_symp = random.choices(stypes, k=2)
        else:
            init_symp = random.choices(stypes, k=3)
        patients.append(Patient(id=i + 1, name=names[i], severity=sev, initial_symptoms=init_symp))
    random.shuffle(patients)
    return patients
 
 
