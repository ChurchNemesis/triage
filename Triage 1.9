# MAIN ENTRY POINT
# ═══════════════════════════════════════════════════════════════
 
def main():
    global NUM_PLAYERS, ACTIONS_PER_PLAYER, TOTAL_TURNS, ARRIVALS_PER_TURN
    global PATIENT_HEALTH, DEATH_THRESHOLD, ROOM_CAPACITY
 
    parser = argparse.ArgumentParser(
        description="TRIAGE: The Board Game -- Digital Simulation",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python triage.py                         Interactive mode
  python triage.py --mode simulate         Run 100 simulated games
  python triage.py --mode simulate -n 500  Run 500 simulated games
  python triage.py --seed 42               Reproducible game
  python triage.py --mode simulate -v      Verbose simulation
""",
    )
    parser.add_argument("--mode", choices=["interactive", "simulate"], default="interactive")
    parser.add_argument("-n", "--num-games", type=int, default=100)
    parser.add_argument("-s", "--seed", type=int, default=None)
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--players", type=int, default=None)
    parser.add_argument("--actions", type=int, default=None)
    parser.add_argument("--turns", type=int, default=None)
    parser.add_argument("--arrivals", type=int, default=None)
    parser.add_argument("--health", type=int, default=None)
    parser.add_argument("--deaths", type=int, default=None)
    parser.add_argument("--capacity", type=int, default=None)
    args = parser.parse_args()
 
    if args.players is not None:
        NUM_PLAYERS = args.players
    if args.actions is not None:
        ACTIONS_PER_PLAYER = args.actions
    if args.turns is not None:
        TOTAL_TURNS = args.turns
    if args.arrivals is not None:
        ARRIVALS_PER_TURN = args.arrivals
    if args.health is not None:
        PATIENT_HEALTH = args.health
    if args.deaths is not None:
        DEATH_THRESHOLD = args.deaths
    if args.capacity is not None:
        ROOM_CAPACITY = args.capacity
 
    if args.mode == "interactive":
        run_interactive(seed=args.seed)
    else:
        run_simulation(num_games=args.num_games, base_seed=args.seed, verbose=args.verbose)
 
 
if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"\n{RED}{BOLD}ERROR: {e}{RESET}")
        import traceback
        traceback.print_exc()
        input("Press Enter to close...")
